!--------------------------------------------------!
!                 INPUTS for HRMHD                 !
!--------------------------------------------------!
&box_parameters
  lx = 1.0 ! to be multiplied by 2pi
  ly = 1.0 ! to be multiplied by 2pi
  lz = 1.0 ! to be multiplied by 2pi

  nlx = 128
  nly = 128
  nlz = 64
/

!==============================================================================
&time_parameters
  dt    = 2.0d-3
  nstep = 200000
  cfl   = 0.8d0              ! cfl <= 0.8 keeps omega*dt below sqrt(3), the RK3 limit, at the
                             ! dealiasing cutoff (the linear bound is dt <= cfl*dlz/vmax_KAW).
  reset_method = 'decrement'  !'multiply'  => multiply by a factor of 0.5
                             !'decrement' => decrement the top integer of dt
  increase_dt = 0e+0         !When max dt computed from the cfl condition is
                             ! larger than this value, set dt = increase_dt.

                             ! When the file 'dt_adjust' including a float number is created,
                             ! dt will be manually adjusted to that value while running.
/

!==============================================================================
&scheme_parameters
  time_step_scheme = 'eSSPIFRK3' ! 'gear3' or 'eSSPIFRK3'
/

!==============================================================================
&operation_parameters
  nonlinear = T
/

!==============================================================================
&physical_parameters
  rho = 1d-1  ! ion sound Larmor radius (Hall scale) in units of the box length/2pi
  sgm = 1d+0  ! 1 + Z/tau

  ! perp hyper dissipation ~ nu_x*(kprp^2/kprp_max^2)^exp
  nupe_x  = 8d+1  ! for phi
  nupe_x_exp  = 3
  etape_x = 4d+2  ! for psi
  etape_x_exp = 3
  nupa_x  = 8d+1  ! for upa
  nupa_x_exp  = 3
  etapa_x = 4d+2  ! for bpa
  etapa_x_exp = 3

  ! para hyper dissipation ~ nu_z*(kz^2/kz_max^2)^exp
  nupe_z  = 1d+1
  nupe_z_exp  = 3
  etape_z = 1d+1
  etape_z_exp = 3
  nupa_z  = 1d+1
  nupa_z_exp  = 3
  etapa_z = 1d+1
  etapa_z_exp = 3
/

!==============================================================================
&initial_condition
  init_type = 'zero'
  !init_type = 'single_mode'  ! uses mode_k[xyz], amp_{phi,psi,upa,bpa}
  !init_type = 'OT3'
  !init_type = 'random'       ! uses init_seed
  !init_type = 'restart'
/

!==============================================================================
!  elsasser = .false.: forced_fields among phi, psi, upa, bpa
!  elsasser = .true. : forced_fields must be (zppe, zmpe); upa, bpa are not forced
&force
  driven = T
  elsasser = .true.
  fix_power = .true.
  ene_inj = 1.0d0
  xhl_inj = 0.8d0 ! 0 <= xhl_inj <= 1 ! helicity injection rate. only when elsasser = .true.
  kmin = 0.d0  0.d0  1.d0
  kmax = 1.0d0  1.0d0  2.d0
  nfields = 2
/
&forced_fields
  field_names = 'zppe'      , 'zmpe'
  amplitudes  =  1.0       ,  1.0
  frequencies = (0.9, -0.6), (0.9, -0.6)
/

!==============================================================================
&terminate
  max_wall_time   = 9.5             ! The simulation will be terminated when the wall
                                    ! time exceeds this value (in the unit of hour).

  terminate_file_name = 'terminate' ! The simulation will be terminated when the file
                                    ! named this value is created in the root directory
                                    ! in the middle of simulaiton.
/

!==============================================================================
&diagnostics_parameters
  write_intvl         = 0.1d0  ! output every this value.
  write_intvl_2D      = 5.0d0  ! output every this value.
  write_intvl_3D      = 0.0d0  ! output every this value.
/

!==============================================================================
&restart_parameters
  save_restart_intvl = 1.0d0      ! save every this value.
  restart_dir = './restart/'
/

