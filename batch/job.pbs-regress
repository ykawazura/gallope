#!/bin/sh -l

#------ qsub option --------#
#PBS -q regular-g
#PBS -l select=4:mpiprocs=1
#PBS -l walltime=00:20:00
#PBS -W group_list=gr96
#PBS -j oe

#------- Program execution -------#
module load nvidia
module load nv-hpcx
module load hdf5
module load netcdf
module load netcdf-fortran

cd ${PBS_O_WORKDIR}

# Phase 0-A bitwise regression, DETERMINISTIC config (OT2 IC, driven=F, P_m=P_s=1).
# Run the SAME binary twice and byte-compare, to prove the run is deterministic
# run-to-run before comparing across the baseline/0-A builds.
mkdir -p restart_regress run1 run2

mpirun ./gallope regress <regress.in >run1.std 2>&1
cp -a restart_regress/phi.dat restart_regress/omg.dat restart_regress/psi.dat restart_regress/time.dat run1/
cp -a regress.out.nc run1/ 2>/dev/null

mpirun ./gallope regress <regress.in >run2.std 2>&1
cp -a restart_regress/phi.dat restart_regress/omg.dat restart_regress/psi.dat restart_regress/time.dat run2/
cp -a regress.out.nc run2/ 2>/dev/null

echo "=== run1 completion ==="; tail -2 run1.std
echo "=== run2 completion ==="; tail -2 run2.std
echo "=== DETERMINISM CHECK (run1 vs run2, same binary) ==="
for f in phi omg psi; do
  if cmp -s run1/$f.dat run2/$f.dat; then echo "  $f.dat : IDENTICAL"; else echo "  $f.dat : DIFFER"; fi
done
