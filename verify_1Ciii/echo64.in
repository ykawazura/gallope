!--------------------------------------------------!
!  1-C-iii DRIVEN-ECHO validation (64^2 x 32, nm=32) !
!                                                     !
!  Fixes the free-decay problem of prod128 (job with  !
!  Alfven-only forcing): the compressive g cascade    !
!  had NO free-energy source (advection {Phi,g} and    !
!  parallel streaming both conserve W = 1/2 sum|g_m|^2 !
!  -> W could only decay). Meyrand 2019 drives g at    !
!  m=1 and low wavenumbers with a CONSTANT compressive !
!  free-energy injection rate. Here g1 is added as a   !
!  third forced field (fix_power, ene_inj_g) sharing   !
!  the low-k stir shell of the Alfven drive.           !
!                                                     !
!  Staged, CHEAP validation before the 128^2 x 64      !
!  production figure. Two gates:                       !
!   (1) DRIVEN STEADY STATE: W_free plateaus and       !
!       fluctuates about a nonzero mean (RELRMS small),!
!       NOT the monotonic decay of the passive run.    !
!   (2) STOCHASTIC ECHO: <Gamma_m(k_perp)> ~ 0 across   !
!       the inertial range (ECHO_RATIO << 1), vs the    !
!       nonlinear=F forward cascade (lin64, ratio ~1).  !
!                                                     !
!  Dissipation coefficients UNCHANGED from prod128     !
!  (normalized to k_max / m=nm -> resolution-agnostic).!
!  np=16 (P_fft=4, P_m=4, P_s=1). dt starts 2e-4, the  !
!  auto-limiter rides it down. Restart every 10 t.     !
!--------------------------------------------------!
&parallelization
  P_m = 4
  P_s = 1
/

&box_parameters
  lx = 1.0
  ly = 1.0
  lz = 1.0
  nlx = 64
  nly = 64
  nlz = 32
  nm  = 32
/

&time_parameters
  dt    = 2.0d-4
  nstep = 1000000
  cfl   = 0.5d0
  reset_method = 'decrement'
  increase_dt = 0e+0
/

&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

&operation_parameters
  nonlinear          = T
  write_hermite_flux = T
/

&physical_parameters
  ! Alfvenic (phi,psi) hyper-dissipation keeps the RMHD bath stable.
  nupe_x      = 4d+3
  nupe_x_exp  = 4
  etape_x     = 4d+3
  etape_x_exp = 4
  nupe_z      = 4d+1
  nupe_z_exp  = 4
  etape_z     = 4d+1
  etape_z_exp = 4

  ! Kinetic (g) closure: perp hyperviscosity mu at k_perp,max and a small
  ! Hermite hypercollision nu at m=nm (both steep so the inertial range is
  ! left clean; m=0 is undamped).
  v_th          = 1.d0
  mu_hyper_perp = 1.d1
  nexp_perp     = 4
  nu_hyper_m    = 1.d0
  nexp_m        = 6
  beta_i        = 1.d0
  tau           = 1.d0
  Zcharge       = 1.d0
  alpha_root    = 1
/

&initial_condition
  init_type = 'random'
  init_seed = 7
/

!  elsasser => Alfven drive is (zppe, zmpe); g1 is the compressive
!  m=1 drive (Meyrand 2019). All three share the low-k stir shell
!  kmin..kmax. ene_inj_g fixes the compressive free-energy injection
!  rate (only the comm_m rank owning m=1 injects).
&force
  driven    = T
  elsasser  = .true.
  fix_power = .true.
  ene_inj   = 1.0d0
  xhl_inj   = 0.8d0
  ene_inj_g = 1.0d0
  kmin = 0.d0  0.d0  1.d0
  kmax = 1.0d0  1.0d0  2.d0
  nfields = 3
  stir_seed = 7
/
&forced_fields
  field_names = 'zppe'      , 'zmpe'      , 'g1'
  amplitudes  =  1.0        ,  1.0        ,  1.0
  frequencies = (0.9, -0.6) , (0.9, -0.6) , (0.9, -0.6)
/

&terminate
  max_wall_time   = 0.6
  terminate_file_name = 'terminate'
/

&diagnostics_parameters
  write_intvl         = 0.25d0
  write_intvl_2D      = 0.0d0
  write_intvl_3D      = 0.0d0
  SF2_nsample = 100000
/

&restart_parameters
  save_restart_intvl = 10.0d0
  restart_dir = './restart/'
/
