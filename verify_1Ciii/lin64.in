!--------------------------------------------------!
!  1-C-iii LINEAR CONTRAST control (64^2 x 32, nm=32) !
!                                                     !
!  Identical to echo64.in EXCEPT nonlinear = F. With  !
!  advection {Phi,g} and the {Psi,S_m} anti-mixing    !
!  term OFF, g1 forcing feeds a PURE forward Hermite   !
!  phase-mixing cascade: linear streaming v_th d_z S_m !
!  carries free energy m=1 -> high m, dissipated by    !
!  the Hermite hypercollision. Expected signature:     !
!    - W_free rises to a plateau (injection=dissip),   !
!    - Gamma_m(k_perp) > 0 and roughly constant across  !
!      the inertial range (ECHO_RATIO ~ 1),            !
!  the baseline against which echo64's ECHO_RATIO << 1  !
!  (stochastic echo) is judged. Also the cheapest       !
!  end-to-end test of the g1-forcing wiring.            !
!                                                     !
!  nonlinear=F => dt is NOT CFL-limited (fixed 2e-4,    !
!  safely below the kinetic streaming CFL ~9e-4).       !
!--------------------------------------------------!
&parallelization
  P_m = 4
  P_s = 1
/

&box_parameters
  lx = 1.0
  ly = 1.0
  lz = 1.0
  nlx = 64
  nly = 64
  nlz = 32
  nm  = 32
/

&time_parameters
  dt    = 2.0d-4
  nstep = 1000000
  cfl   = 0.5d0
  reset_method = 'decrement'
  increase_dt = 0e+0
/

&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

&operation_parameters
  nonlinear          = F
  write_hermite_flux = T
/

&physical_parameters
  nupe_x      = 4d+3
  nupe_x_exp  = 4
  etape_x     = 4d+3
  etape_x_exp = 4
  nupe_z      = 4d+1
  nupe_z_exp  = 4
  etape_z     = 4d+1
  etape_z_exp = 4

  v_th          = 1.d0
  mu_hyper_perp = 1.d1
  nexp_perp     = 4
  nu_hyper_m    = 1.d0
  nexp_m        = 6
  beta_i        = 1.d0
  tau           = 1.d0
  Zcharge       = 1.d0
  alpha_root    = 1
/

&initial_condition
  init_type = 'random'
  init_seed = 7
/

&force
  driven    = T
  elsasser  = .true.
  fix_power = .true.
  ene_inj   = 1.0d0
  xhl_inj   = 0.8d0
  ene_inj_g = 1.0d0
  kmin = 0.d0  0.d0  1.d0
  kmax = 1.0d0  1.0d0  2.d0
  nfields = 3
  stir_seed = 7
/
&forced_fields
  field_names = 'zppe'      , 'zmpe'      , 'g1'
  amplitudes  =  1.0        ,  1.0        ,  1.0
  frequencies = (0.9, -0.6) , (0.9, -0.6) , (0.9, -0.6)
/

&terminate
  max_wall_time   = 0.25
  terminate_file_name = 'terminate'
/

&diagnostics_parameters
  write_intvl         = 0.25d0
  write_intvl_2D      = 0.0d0
  write_intvl_3D      = 0.0d0
  SF2_nsample = 100000
/

&restart_parameters
  save_restart_intvl = 10.0d0
  restart_dir = './restart/'
/
