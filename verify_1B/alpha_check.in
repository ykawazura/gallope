!--------------------------------------------------!
!  1-B alpha unit check. Distinctive inputs          !
!  beta_i=2, tau=1, Zcharge=1, alpha_root=+1 give    !
!    kappa = sqrt((1+1)^2 + 1/4) = sqrt(4.25)        !
!          = 2.0615528128088303                      !
!    alpha = 1/(1 - 0.5 + kappa)                     !
!          = 1/2.5615528128088303                    !
!          = 3.9038820320220757e-01 (hand value).    !
!  The [alpha_check] banner printed by proc0 must    !
!  reproduce this. Tiny run (a couple of steps) is    !
!  enough to fire the diagnostic once.                !
!--------------------------------------------------!
&parallelization
  P_m = 1
  P_s = 1
/

&box_parameters
  lx = 1.0
  ly = 1.0
  lz = 6.283185307179586d0
  nlx = 8
  nly = 8
  nlz = 16
  nm  = 4
/

&time_parameters
  dt    = 1.0d-2
  nstep = 2
  cfl   = 2.0d0
  reset_method = 'decrement'
  increase_dt = 0e+0
/

&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

&operation_parameters
  nonlinear = F
/

&physical_parameters
  nupe_x      = 0.d0
  nupe_x_exp  = 4
  etape_x     = 0.d0
  etape_x_exp = 4
  nupe_z      = 0.d0
  nupe_z_exp  = 4
  etape_z     = 0.d0
  etape_z_exp = 4

  v_th          = 1.d0
  mu_hyper_perp = 0.d0
  nexp_perp     = 4
  nu_hyper_m    = 0.d0
  nexp_m        = 6
  beta_i        = 2.d0
  tau           = 1.d0
  Zcharge       = 1.d0
  alpha_root    = 1
/

&initial_condition
  init_type = 'single_mode'
  init_seed = 42
/

&force
  driven = F
/

&terminate
  max_wall_time   = 0.5
  terminate_file_name = 'terminate'
/

&diagnostics_parameters
  write_intvl         = 0.005d0
  write_intvl_2D      = 0.0d0
  write_intvl_3D      = 0.0d0
  SF2_nsample = 100000
/

&restart_parameters
  save_restart_intvl = 100.0d0
  restart_dir = './restart/'
/
