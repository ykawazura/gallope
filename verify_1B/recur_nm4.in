!--------------------------------------------------!
!  1-B finite-Hermite TRUNCATION recurrence test.   !
!  IDENTICAL to landau_nu0.in (collisionless,        !
!  nu_hyper_m=0, single global g_0 mode) EXCEPT      !
!  nm=4 instead of nm=16. With only 4 Hermite rungs  !
!  the phase-mixed packet reflects off the truncation !
!  early and violently: g0var recurs to O(0.7-0.8)   !
!  of its initial value (vs ~7e-3 at nm=16). This is  !
!  the genuine finite-N Hermite recurrence, and it is !
!  SUPPRESSED simply by increasing nm (nm4~0.76,      !
!  nm8~7e-3, nm>=8 converged) -- it is NOT the        !
!  reversible ballistic echo seen at all nm. Used as  !
!  the (f) verdict: peak(nm4) >> peak(nm16).          !
!  Everything else matches landau_nu0.in.             !
!--------------------------------------------------!
&parallelization
  P_m = 1
  P_s = 1
/

&box_parameters
  lx = 1.0
  ly = 1.0
  lz = 6.283185307179586d0
  nlx = 8
  nly = 8
  nlz = 16
  nm  = 4
/

&time_parameters
  dt    = 1.0d-2
  nstep = 3000
  cfl   = 2.0d0
  reset_method = 'decrement'
  increase_dt = 0e+0
/

&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

&operation_parameters
  nonlinear = F
/

&physical_parameters
  nupe_x      = 0.d0
  nupe_x_exp  = 4
  etape_x     = 0.d0
  etape_x_exp = 4
  nupe_z      = 0.d0
  nupe_z_exp  = 4
  etape_z     = 0.d0
  etape_z_exp = 4

  v_th          = 1.d0
  mu_hyper_perp = 0.d0
  nexp_perp     = 4
  nu_hyper_m    = 0.d0
  nexp_m        = 6
  beta_i        = 1.d0
  tau           = 1.d0
  Zcharge       = 1.d0
  alpha_root    = 1
/

&initial_condition
  init_type = 'single_mode'
  init_seed = 42
/

&force
  driven = F
/

&terminate
  max_wall_time   = 0.5
  terminate_file_name = 'terminate'
/

&diagnostics_parameters
  write_intvl         = 0.1d0
  write_intvl_2D      = 0.0d0
  write_intvl_3D      = 0.0d0
  SF2_nsample = 100000
/

&restart_parameters
  save_restart_intvl = 100.0d0
  restart_dir = './restart/'
/
