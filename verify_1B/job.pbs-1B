#!/bin/sh -l
#------ qsub option --------#
#PBS -q regular-g
#PBS -l select=16:mpiprocs=1
#PBS -l walltime=01:00:00
#PBS -W group_list=gr96
#PBS -j oe
#PBS -N krmhd_1B

#=====================================================================
#  Milestone 1-B verification driver (streaming term v_th grad_par S_m,
#  closure, kinetic CFL, alpha). One 16-node allocation runs:
#    (a) determinism        : pm1 vs pm1b (identical binary+input)
#    (b) P_m-invariance      : pm1 vs pm4 (P_fft=4 fixed) checksum + g.dat
#    (c) linear Landau/recur : landau_nu0 (nu=0) g0var recurs, W_eq6 conserved
#    (d) collisional sink    : landau_nu  (nu>0) W_eq6 drained, resolved g0 intact
#    (e) alpha unit check    : alpha_check prints alpha == hand value
#    (f) truncation recur    : recur_nm4 (nm=4) g0 recurs >> landau_nu0 (nm=16)
#=====================================================================
module load nvidia
module load nv-hpcx
module load hdf5
module load netcdf
module load netcdf-fortran

set -u
cd ${PBS_O_WORKDIR}

ROOT=${PBS_O_WORKDIR}
BIN=${ROOT}/../gallope          # KRMHD binary built in the repo root
RUN=${ROOT}/runs
rm -rf "${RUN}"
mkdir -p "${RUN}"

ALPHA_REF=0.3903882032022076    # hand value for beta_i=2, tau=1, Z=1, root=+1

# ---- helper: run one case in its own subdir ------------------------
run_case () {   # $1=name  $2=np  $3=infile
  name=$1; np=$2; inf=$3
  d="${RUN}/${name}"
  mkdir -p "${d}/restart" "${d}/out2d" "${d}/out3d"
  cp "${ROOT}/${inf}" "${d}/gallope.in"
  ( cd "${d}" && mpirun -np "${np}" "${BIN}" <gallope.in >out.std 2>&1 )
  echo "[driver] ${name} (np=${np}) done, rc=$?"
}

allchk () {  # extract the FULL sequence of g XOR checksums printed by a run
  grep -h "check_g_consistency] global g XOR checksum" "${RUN}/$1/out.std" \
    | sed 's/.*= //'
}

probe () {   # extract the "tt Wg_tot g0var W_eq6" rows printed by a run
             #   $1=tt  $2=Wg_tot  $3=g0var  $4=W_eq6(eq 6, conserved for nu=0)
  grep -h "\[g_probe\]" "${RUN}/$1/out.std" | sed 's/.*= //' \
    > "${RUN}/$1.g0var.dat"
  cat "${RUN}/$1.g0var.dat"
}

echo "================ 1-B verification runs ================"
run_case pm1         4  pm1.in
run_case pm1b        4  pm1.in          # determinism: same input, fresh run
run_case pm4         16 pm4.in
run_case landau_nu0  4  landau_nu0.in
run_case landau_nu   4  landau_nu.in
run_case recur_nm4   4  recur_nm4.in
run_case alpha_check 4  alpha_check.in

echo
echo "================ 1-B verification summary ============="

pass=0; fail=0
verdict () { # $1=label $2=cond(0=pass)
  if [ "$2" -eq 0 ]; then echo "PASS  $1"; pass=$((pass+1));
  else echo "FAIL  $1"; fail=$((fail+1)); fi
}

# ---------- (a) determinism: full checksum sequence pm1 == pm1b ----------
allchk pm1  > "${RUN}/pm1.chk"
allchk pm1b > "${RUN}/pm1b.chk"
echo "pm1  checksums: $(wc -l <"${RUN}/pm1.chk") steps, last = $(tail -1 "${RUN}/pm1.chk")"
echo "pm1b checksums: $(wc -l <"${RUN}/pm1b.chk") steps, last = $(tail -1 "${RUN}/pm1b.chk")"
[ -s "${RUN}/pm1.chk" ] && cmp -s "${RUN}/pm1.chk" "${RUN}/pm1b.chk"
verdict "(a) determinism: pm1 all-step checksums == pm1b (race-free)" $?

# ---------- (b) P_m-invariance: pm1 == pm4 (all steps) + g.dat ----------
allchk pm4 > "${RUN}/pm4.chk"
echo "pm4  checksums: $(wc -l <"${RUN}/pm4.chk") steps, last = $(tail -1 "${RUN}/pm4.chk")"
[ -s "${RUN}/pm1.chk" ] && cmp -s "${RUN}/pm1.chk" "${RUN}/pm4.chk"
verdict "(b) P_m-invariance: pm1 all-step checksums == pm4" $?
cmp -s "${RUN}/pm1/restart/g.dat" "${RUN}/pm4/restart/g.dat"
verdict "(b) P_m-invariance: restart g.dat byte-identical" $?

# ---------- (c) linear Landau + recurrence (nu=0) ----------
# g0var = column 3, W_eq6 (Meyrand eq 6, the streaming-conserved free energy)
# = column 4. Wg_tot (column 2) is NOT conserved when alpha/=0, so we test the
# eq (6) invariant instead. Recurrence is keyed off the g0var deep null (argmin):
# the collisionless packet reflects off the truncation and g0var RECOVERS after
# the null; the recovery peak REC = max(g0var, t>t_null) is the recurrence.
probe landau_nu0 >/dev/null
WDRIFT0=$(awk 'NR==1{w0=$4} {d=($4-w0)/w0; if(d<0)d=-d; if(d>mx)mx=d} END{printf "%.6e", mx}' "${RUN}/landau_nu0.g0var.dat")
MIN0=$(awk  'NR==1||$3<m{m=$3}          END{printf "%.6e", m}'   "${RUN}/landau_nu0.g0var.dat")
TNULL0=$(awk 'NR==1||$3<m{m=$3;t=$1}    END{printf "%.4f", t}'   "${RUN}/landau_nu0.g0var.dat")
REC0=$(awk -v tn="${TNULL0}" '$1>tn{if($3>r)r=$3} END{printf "%.6e", r+0}' "${RUN}/landau_nu0.g0var.dat")
echo "landau_nu0: W_eq6 drift=${WDRIFT0}  min(g0var)=${MIN0} @t=${TNULL0}  recur peak(t>null)=${REC0}"
awk -v d="${WDRIFT0}" 'BEGIN{exit !(d<5.0e-3)}';            verdict "(c) nu=0 eq(6) free energy W conserved (<0.5% drift)" $?
awk -v m="${MIN0}"    'BEGIN{exit !(m<5.0e-2)}';            verdict "(c) nu=0 Landau phase-mixing to deep null (min g0var<0.05)" $?
awk -v r="${REC0}" -v m="${MIN0}" 'BEGIN{exit !(r>10*m)}';  verdict "(c) nu=0 recurrence present (peak > 10x null)" $?

# ---------- (d) production hypercollision: free-energy sink (nu>0) ----------
# The nexp_m=6 closure drains W_eq6 (col 4) as an irreversible sink while
# leaving the RESOLVED low-m dynamics (g0var, col 3) essentially intact: the
# Landau null still forms and the resolved g0 echo still recurs. (The reversible
# ballistic echo is not a truncation artifact and is not meant to be suppressed
# by a good closure -- finite-N truncation recurrence is addressed by (f).)
probe landau_nu >/dev/null
WEND=$(awk 'NR==1{w0=$4} END{printf "%.6e", $4/w0}'      "${RUN}/landau_nu.g0var.dat")
MINN=$(awk  'NR==1||$3<m{m=$3}       END{printf "%.6e", m}' "${RUN}/landau_nu.g0var.dat")
TNULLN=$(awk 'NR==1||$3<m{m=$3;t=$1} END{printf "%.4f", t}' "${RUN}/landau_nu.g0var.dat")
RECN=$(awk -v tn="${TNULLN}" '$1>tn{if($3>r)r=$3} END{printf "%.6e", r+0}' "${RUN}/landau_nu.g0var.dat")
echo "landau_nu : W_eq6 end/start=${WEND}  min(g0var)=${MINN} @t=${TNULLN}  recur peak(t>null)=${RECN}"
awk -v w="${WEND}" 'BEGIN{exit !(w<5.0e-1)}';             verdict "(d) nu>0 eq(6) free-energy sink (W drained >50%, W_end/W_0<0.5)" $?
awk -v m="${MINN}" 'BEGIN{exit !(m<5.0e-2)}';            verdict "(d) nu>0 Landau phase-mixing still present (min g0var<0.05)" $?
awk -v r="${RECN}" -v m="${MINN}" 'BEGIN{exit !(r>10*m)}'; verdict "(d) nu>0 resolved g0 echo intact (peak > 10x null)" $?

# ---------- (f) finite-Hermite truncation recurrence controlled by nm --------
# recur_nm4 is landau_nu0 with nm=4 instead of 16. With only 4 rungs the
# phase-mixed packet reflects off the truncation and g0var recurs to O(1), vs
# ~7e-3 at nm=16 -- the genuine finite-N recurrence, suppressed by raising nm.
probe recur_nm4 >/dev/null
TNULLF=$(awk 'NR==1||$3<m{m=$3;t=$1} END{printf "%.4f", t}' "${RUN}/recur_nm4.g0var.dat")
RECF=$(awk -v tn="${TNULLF}" '$1>tn{if($3>r)r=$3} END{printf "%.6e", r+0}' "${RUN}/recur_nm4.g0var.dat")
echo "recur_nm4 : recur peak(t>null)=${RECF} @null_t=${TNULLF}   (cf nm=16 peak=${REC0})"
awk -v r="${RECF}" 'BEGIN{exit !(r>1.0e-1)}';               verdict "(f) nm=4 truncation recurrence is large (peak > 0.1)" $?
awk -v f="${RECF}" -v z="${REC0}" 'BEGIN{exit !(f>20*z)}';  verdict "(f) truncation recurrence controlled by nm (nm4 peak > 20x nm16 peak)" $?

# ---------- (e) alpha unit check ----------
A=$(grep -h "\[alpha_check\] v_th alpha" "${RUN}/alpha_check/out.std" | tail -1 \
    | sed 's/.*= //' | awk '{print $2}')
echo "alpha_check: printed alpha=${A}  ref=${ALPHA_REF}"
awk -v a="${A}" -v r="${ALPHA_REF}" 'BEGIN{d=a-r; if(d<0)d=-d; exit !(d<1.0e-12)}'
verdict "(e) alpha == hand value (beta_i=2,tau=1,Z=1,root+1)" $?

echo
echo "TOTAL: ${pass} passed, ${fail} failed"
echo "======================================================="
