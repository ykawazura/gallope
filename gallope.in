!--------------------------------------------------------------------!
!  MID-RESOLUTION KRMHD run (64^2 x 32, nm=32, np=4) -- RESTART.       !
!                                                                     !
!  RESTART continuation chunk of the imbalanced-forcing KRMHD run.     !
!  Chain: gallope.in1 is the zero-IC start; each later chunk restarts  !
!  from the previous checkpoint. init_type='restart' reads             !
!  restart_dir=./restart/ (g, omg, phi, psi, time.dat) and resumes     !
!  the SAME physics/grid/forcing (xhl_inj=0.8) -- no parameter changes !
!  between chunks, so this input is reused unedited for every restart. !
!                                                                     !
!  Physics: chunks 1-3 (tt=0->25.19) show the compressive free energy !
!  W_free steady (~2.9) but the Alfvenic energy Waw still growing      !
!  secularly (Waw_dot>0, slowly decreasing; sigma_c->0.98): the        !
!  imbalanced condensate/pile-up where the depleted minority Elsasser  !
!  field shuts down the cascade, so injection (Paw~1.0) outpaces       !
!  dissipation (Daw, rising toward Paw) and energy accumulates at      !
!  large scales. Each chunk probes how far Waw climbs toward Daw~Paw.  !
!                                                                     !
!  With xhl_inj=0.8 the fix_power forcing injects UNEQUAL power into   !
!  Z+ and Z- each step (net cross-helicity injection).                !
!                                                                     !
!  gallope.out.nc is recreated fresh (NF90_CLOBBER) at the restart tt, !
!  so consecutive chunks overlap by one seam record; the diagnostics   !
!  loader (load.py) dedups duplicate timestamps.                      !
!                                                                     !
!  np=4 => [P_fft=4, P_m=1, P_s=1]: cuFFTMp splits the FFT across the  !
!  4 GPUs, each rank owns all m. debug-g queue (4 nodes, <=30 min);   !
!  nstep=20000 (~17 min wall) advances ~6 time units at dt~3e-4; the  !
!  run self-checkpoints at max_wall_time=0.45h for restarts.           !
!--------------------------------------------------------------------!
&parallelization
  P_m = 1
  P_s = 1
/

&box_parameters
  lx = 1.0
  ly = 1.0
  lz = 1.0
  nlx = 64
  nly = 64
  nlz = 32
  nm  = 32
/

&time_parameters
  dt    = 5.0d-3
  nstep = 20000
  cfl   = 0.5d0
  reset_method = 'decrement'
  increase_dt = 0e+0
/

&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

&operation_parameters
  nonlinear          = T
  write_hermite_flux = F
/

&physical_parameters
  ! Alfvenic (phi,psi) hyper-dissipation (RMHD-inherited); scaled up
  ! from lowres to keep the Alfven bath bounded on the finer grid.
  nupe_x      = 8.0d+3
  nupe_x_exp  = 4
  etape_x     = 8.0d+3
  etape_x_exp = 4
  nupe_z      = 6.0d+1
  nupe_z_exp  = 4
  etape_z     = 6.0d+1
  etape_z_exp = 4

  ! Kinetic (g) closure: perp k^4 hyperviscosity + Hermite m^6 hypercollision.
  ! These ARE the D_g sink checked by the balance, so both are nonzero.
  ! v_th is derived (= sqrt(beta_i) = 1 here).
  mu_hyper_perp = 1.0d+3
  nexp_perp     = 2
  nu_hyper_m    = 3.0d0
  nexp_m        = 6
  beta_i        = 1.d0
  tau           = 1.d0
  Zcharge       = 1.d0
  alpha_root    = 1
/

&initial_condition
  init_type = 'restart'   ! resume from restart_dir checkpoint (chunk chain)
  init_seed = 7           ! unused on restart (kept for reproducibility of stir)
/

&force
  driven    = T
  elsasser  = .true.
  fix_power = .true.
  ene_inj   = 1.0d0
  xhl_inj   = 0.8d0
  ene_inj_g = 1.0d0
  kmin = 0.d0  0.d0  1.d0
  kmax = 1.0d0  1.0d0  2.d0
  nfields = 3
  stir_seed = 404        ! RE-SEEDED 303->404 to skip the 4th fix_power injection jump.
                         ! seed=303 cleared the tt=102.3 blow-up and ran ~11 t.u. (a Waw plateau at
                         ! tt~106-110 was NOT saturation but a pre-jump lull) before a moderate jump
                         ! at tt=112.50 (Waw 38.8->43.4 x1.12). Restored the pre-jump checkpoint
                         ! restart18 (tt=109.50, last clean seed=303 state) and drew a new realization.
                         ! Treadmill confirmed (jumps recur every 6-24 t.u.); real saturation needs a
                         ! large-scale drag on (phi,psi) or a normalize_force_els fix.
/
&forced_fields
  field_names = 'zppe'      , 'zmpe'      , 'g1'
  amplitudes  =  1.0        ,  1.0        ,  1.0
  frequencies = (0.9, -0.6) , (0.9, -0.6) , (0.9, -0.6)
/

&terminate
  max_wall_time   = 0.45
  terminate_file_name = 'terminate'
/

&diagnostics_parameters
  write_intvl         = 0.1d0
  write_intvl_2D      = 2.0d0   ! EM field real-space cross-sections for plot_fields
  write_intvl_3D      = 0.0d0
  SF2_nsample = 100000
/

&restart_parameters
  save_restart_intvl = 5.0d0
  restart_dir = './restart/'
/
