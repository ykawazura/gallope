#!/bin/sh -l
#------ qsub option --------#
#PBS -q regular-g
#PBS -l select=64:mpiprocs=1
#PBS -l walltime=01:00:00
#PBS -W group_list=gr96
#PBS -j oe
#PBS -N echo128mu

#=====================================================================
#  BALANCED driven-echo run (128^2 x 64, nm=128, np=64 =>
#  P_fft=8, P_m=8, P_s=1). Balanced Alfvenic forcing (xhl_inj=0).
#  Separate run dir (runs_echo128mu) from the imbalanced run so the
#  two chains never collide (lesson L18: 1 run dir = 1 job). Set INPUT
#  to echo128mu.in for the first launch (random IC, FRESH=1) and to
#  echo128mu_restart.in for continuation (init_type='restart', FRESH=0).
#=====================================================================
module load nvidia
module load nv-hpcx
module load hdf5
module load netcdf
module load netcdf-fortran

set -u
cd ${PBS_O_WORKDIR}

ROOT=${PBS_O_WORKDIR}
BIN=${ROOT}/../gallope

# --- launch config -------------------------------------------------
name=echo128mu            # base name for the run dir (runs_echo128mu)
INPUT=${INPUT:-echo128mu.in}   # override with: qsub -v INPUT=echo128mu_restart.in ...
FRESH=${FRESH:-1}          # 1 = wipe run dir (first launch); 0 = keep for restart
# -------------------------------------------------------------------

RUN=${ROOT}/runs_${name}
if [ "${FRESH}" = "1" ]; then
  rm -rf "${RUN}"
  mkdir -p "${RUN}/restart" "${RUN}/out2d" "${RUN}/out3d"
fi
cp "${ROOT}/${INPUT}" "${RUN}/gallope.in"

echo "================ ${name} (INPUT=${INPUT}, FRESH=${FRESH}) 128^2 x 64 nm=128 np=64 [8,8,1] balanced k4 ================"
t0=$(date +%s)
( cd "${RUN}" && mpirun -np 64 "${BIN}" <gallope.in >>out.std 2>&1 )
rc=$?
t1=$(date +%s)
echo "[driver] ${name} done, rc=${rc}, wall=$((t1 - t0))s"

echo "----- tail of ${name} out.std -----"
tail -30 "${RUN}/out.std"
echo "----- tail of ${name} cfl.dat: tt dt_cfl max_vel_x max_vel_y -----"
tail -4 "${RUN}/cfl.dat" 2>/dev/null || echo "(no cfl.dat)"
echo "----- restart files -----"
ls -la "${RUN}/restart/" 2>/dev/null | tail -8

NC=$(ls "${RUN}"/*.out.nc 2>/dev/null | head -1)
if [ -z "${NC}" ]; then
  echo "ERROR: no NetCDF output for ${name}"
else
  # Preserve this segment's NetCDF under a jobid-stamped name: the code
  # opens gallope.out.nc with NF90_CLOBBER, so the next restart segment
  # would otherwise destroy it before we can pull it. tt is continuous
  # across segments (read from time.dat), so the pulled files stitch by tt.
  SEG="${ROOT}/echo128mu_seg_${PBS_JOBID%%.*}.nc"
  cp "${NC}" "${SEG}" && echo "----- preserved segment NetCDF -> ${SEG} -----"
  echo "----- ${name} analysis (analyze.py, steady window t>=8) -----"
  python3 "${ROOT}/analyze.py" "${NC}" 8.0 2>&1
fi

echo "ECHO128MU_DONE"
