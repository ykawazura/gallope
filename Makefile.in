#=======================================================================
# Edit this file to change code options 
#=======================================================================

# Set architecture name; 'arch/$(arch).in' will be included.
arch = flow

# MODEL :
# 	MHD_INCOMP     ! incompressible MHD
# 	RMHD           ! reduced MHD
# 	KRMHD          ! kinetic RMHD (4D: RMHD + passive Hermite moments g_m)
# 	RRMHD          ! rotating reduced MHD
# 	HRMHD          ! Hall reduced MHD
# 	EMHD           ! electron MHD
MODEL = KRMHD

# debug
DEBG = no
