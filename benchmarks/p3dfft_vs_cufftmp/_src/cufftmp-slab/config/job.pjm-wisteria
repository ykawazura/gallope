module load nvidia
module load nvmpi
export UCX_MEMTYPE_CACHE=n
export UCX_IB_GPU_DIRECT_RDMA=n
mpiexec -machinefile $PJM_O_NODEINF -n $PJM_MPI_PROC -npernode 8 ./cufftmp_r2c
