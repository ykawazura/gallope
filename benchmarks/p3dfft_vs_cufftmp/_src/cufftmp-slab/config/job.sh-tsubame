#!/bin/sh
#=======================================================================
# cuFFTMp slab benchmark on TSUBAME4.0 -- Altair Grid Engine (AGE), NOT PBS.
#
# Run this script; do NOT qsub it -- it submits itself.  The group is charged
# through `qsub -g`, which is an option of TSUBAME's qsub wrapper only: written
# as a `#$ -g` directive AGE rejects it ("invalid option argument -g"), and
# AGE's own -P is a different namespace.  $JOB_ID tells the two roles apart.
#
#   ./job.sh-tsubame                                     # 1 node, GPU 1..4, 1024^3
#   GPUS=1:2:3:4 GRIDS=1024 TRIAL=1 ./job.sh-tsubame
#   NODES=8 GPUS=32 GRIDS=1024:2048 TRIAL=2 ./job.sh-tsubame
#   MODE=weak GRIDS=512:1024 NODES=4 GPUS=16 ./job.sh-tsubame
#   NODES=4 GPUS=4 PPN=1 TRIAL=1 ./job.sh-tsubame        # placement control
#
# Why TSUBAME at all, when Fig. 1 was measured on Miyabi: Miyabi-G is one GPU
# per node, so its node1 -> node2 jump conflates "twice the GPUs" with "the
# all-to-all left the node".  Here a node holds 4 H100 on NVLink (~900 GB/s)
# and nodes are joined by 4x NDR200 (800 Gbps, ~9:1), so 1->4 GPUs stays inside
# the node and 5+ GPUs cannot.  Same binary, same grid, one variable changed.
#
# Knobs (lists are COLON-separated; AGE's -v is comma-separated and would eat
# spaces):
#   RESOURCE  node_f | node_h | node_q      GPUs/node 4 | 2 | 1   [node_f]
#   NODES     nodes to allocate                                   [1]
#   GPUS      total GPU counts to run, e.g. 1:2:3:4               [fill]
#   PPN       ranks per node; overrides the default packing       [min(g,gpn)]
#   MODE      strong | weak                                       [strong]
#   GRIDS     strong: N for N^3;  weak: N^3 held per GPU          [1024:2048]
#   TRIAL     trial index, appended to the output file name       [1]
#   H_RT      wall-clock reservation, overrides the directive  [1:00:00]
#   NREPEAT   timed iterations inside the benchmark               [10]
#
# One job = one allocation shape, and it walks the GPU list inside it: three
# INDEPENDENT submissions per configuration (TRIAL=1,2,3) is what gives the
# median and min-max whiskers, so trials must never be looped over in here.
#
# Output: results-202607/tsubame/{strong,weak}_scaling/<N>^3/gpu<G>-node<M>-<T>.
# G and M are both in the name because on this machine they are independent --
# that is the whole point -- and the benchmark also prints "Unique nodes" and
# "GPUs per node" of its own accord, so the placement can be verified from the
# file contents rather than trusted from its name.
#=======================================================================
#$ -cwd
#$ -l h_rt=1:00:00
#$ -N cufftmp_slab
#$ -j y

EXE_NAME=cufftmp_r2c

TSUBAME_GROUP=tgh-26IDS
RESOURCE=${RESOURCE:-node_f}
NODES=${NODES:-1}
MODE=${MODE:-strong}
GRIDS=${GRIDS:-1024:2048}
GPUS=${GPUS:-}
PPN=${PPN:-}
TRIAL=${TRIAL:-1}
NREPEAT=${NREPEAT:-10}
# A command-line -l overrides the #$ directive above, so H_RT is what
# actually reserves the node.  Smoke tests should not book a whole hour.
H_RT=${H_RT:-1:00:00}
RESULTS=${RESULTS:-results-202607/tsubame}

case ${RESOURCE} in
    node_f) GPN=4 ;;
    node_h) GPN=2 ;;
    node_q) GPN=1 ;;
    *) echo "unsupported RESOURCE=${RESOURCE} (need node_f/node_h/node_q)" >&2
       exit 1 ;;
esac

if [ -z "${GPUS}" ]; then
    if [ "${NODES}" -eq 1 ]; then          # sweep the whole node
        GPUS=$(seq -s: 1 ${GPN})
    else
        GPUS=$(( NODES * GPN ))
    fi
fi

if [ -z "${JOB_ID}" ]; then     # not under AGE yet -> submit ourselves
    exec qsub -g ${TSUBAME_GROUP} -l ${RESOURCE}=${NODES} -l h_rt=${H_RT} \
        -v "RESOURCE=${RESOURCE},NODES=${NODES},MODE=${MODE},GRIDS=${GRIDS},GPUS=${GPUS},PPN=${PPN},TRIAL=${TRIAL},NREPEAT=${NREPEAT},H_RT=${H_RT},RESULTS=${RESULTS}" \
        "$0"
fi

. ./config/env-tsubame.sh

ROOT=${PWD}
EXE=${ROOT}/${EXE_NAME}

# Device memory guard.  cuFFTMp holds the descriptor 2*(nz/2+1)*ny*(nx/g) reals
# and needs about as much again for the transpose, so ~2 * 16*(nz/2+1)*ny*nx/g
# bytes per GPU against the 94 GB of an H100.  Sub-runs that do not fit used to
# fall back to a smaller grid silently on Miyabi and had to be caught at plot
# time; here they are refused up front, and the skip is printed rather than
# swallowed so that a hole in the data set is never mistaken for coverage.
#
# 60 GB was the nominal figure and it was never right; the deployed driver has
# been running at 40 GB since 1536^3 on two GPUs (58.1 GB estimated) was seen
# to die while 29.0 GB ran.  This copy is the one a redeploy would take, so it
# had drifted into a trap: reinstalling from config/ would have quietly put the
# 60 GB guard back.  40 GB is now confirmed from the other side as well --
# 2048^3 on four GPUs estimates 34.4 GB and completes in 0.238 s/loop.
# The pencil driver carries a tighter cut of its own; see its copy of this
# comment for why the same formula does not bound both layouts.
DEV_LIMIT=40000000000

fits() {   # $1=nx $2=ny $3=nz $4=ngpu
    need=$(( 2 * 16 * ($3 / 2 + 1) * $2 * $1 / $4 ))
    [ ${need} -le ${DEV_LIMIT} ]
}

run_one() {   # $1=nx $2=ny $3=nz $4=ngpu $5=ppn $6=outfile
    nodes_used=$(( ($4 + $5 - 1) / $5 ))
    mkdir -p "$(dirname "$6")"
    # Every run gets its own directory.  params.in is read from the process's
    # cwd, and the campaign runs many of these jobs against this one -cwd: a
    # shared params.in would let one job's grid size land in another job's
    # timing, and the trailing "rm -f" would delete a file a concurrent job had
    # just written, dropping it back to the built-in default grid.  The output
    # file name would still read correctly -- exactly the kind of plausible
    # wrong number that is unrecoverable at plot time.
    rundir="${ROOT}/runs/${JOB_ID}/${1}x${2}x${3}-gpu${4}-ppn${5}"
    mkdir -p "${rundir}"
    printf '%d %d %d %d\n' "$1" "$2" "$3" "${NREPEAT}" > "${rundir}/params.in"
    echo "== ${MODE} ${1}x${2}x${3}  gpu=${4} ppn=${5} nodes=${nodes_used} -> $6"
    ( cd "${rundir}" && \
      mpirun -n "$4" -npernode "$5" \
          -x LD_LIBRARY_PATH --mca coll_hcoll_enable 0 \
          "${EXE}" ) > "$6" 2>&1
}

echo "resource=${RESOURCE}=${NODES} hosts=${NHOSTS} mode=${MODE}" \
     "grids=${GRIDS} gpus=${GPUS} trial=${TRIAL}"

for g in $(echo "${GPUS}" | tr ':' ' '); do
    if [ -n "${PPN}" ]; then
        ppn=${PPN}
    elif [ "${g}" -lt "${GPN}" ]; then
        ppn=${g}
    else
        ppn=${GPN}
    fi
    nodes_used=$(( (g + ppn - 1) / ppn ))
    if [ "${nodes_used}" -gt "${NHOSTS}" ]; then
        echo "!! skip gpu=${g} ppn=${ppn}: needs ${nodes_used} nodes, have ${NHOSTS}"
        continue
    fi

    for n in $(echo "${GRIDS}" | tr ':' ' '); do
        if [ "${MODE}" = weak ]; then
            # Work per GPU held at n^3, the global box doubled x -> y -> z.
            # g must be a power of two for that to stay exact.
            k=0; p=1
            while [ ${p} -lt ${g} ]; do p=$(( p * 2 )); k=$(( k + 1 )); done
            if [ ${p} -ne ${g} ]; then
                echo "!! skip weak gpu=${g}: not a power of two"
                continue
            fi
            nx=$(( n << ((k + 2) / 3) ))
            ny=$(( n << ((k + 1) / 3) ))
            nz=$(( n << (k / 3) ))
            out="${RESULTS}/weak_scaling/${n}^3/gpu${g}-node${nodes_used}-${TRIAL}"
        else
            nx=${n}; ny=${n}; nz=${n}
            out="${RESULTS}/strong_scaling/${n}^3/gpu${g}-node${nodes_used}-${TRIAL}"
        fi

        # The slab benchmark distributes Y over the ranks without a remainder
        # path (cufftmp_r2c.f90: "ny has to divide evenly by mpi_procs"), so a
        # non-dividing pair would abort inside MPI rather than here.
        if [ $(( ny % g )) -ne 0 ]; then
            echo "!! skip ${nx}x${ny}x${nz} gpu=${g}: ny not divisible by ranks"
            continue
        fi
        if ! fits ${nx} ${ny} ${nz} ${g}; then
            echo "!! skip ${nx}x${ny}x${nz} gpu=${g}: exceeds the device-memory guard"
            continue
        fi

        run_one ${nx} ${ny} ${nz} ${g} ${ppn} "${out}"
    done
done

echo "done."
