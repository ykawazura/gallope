#=======================================================================
# cuFFTMp pencil benchmark on TSUBAME4.0 (Institute of Science Tokyo)
#   AMD EPYC 9654 x2 + H100 SXM5 x4 per node, InfiniBand NDR200 x4 between.
#
# Self-contained: a plain `make` works in a bare login shell with no modules
# loaded, because every toolchain location is pinned as an absolute path.
# config/env-tsubame.sh is still needed at RUN time, for LD_LIBRARY_PATH.
#
# Differences from config/Makefile.miyabi, and why:
#
#   * nvhpc 26.1, not 24.1.  cuFFTMp reaches other nodes through NVSHMEM, and
#     the NVSHMEM 2.10.1 in nvhpc/24.1 cannot open an inter-node transport on
#     this machine: its ibrc wants the nv_peer_mem / nvidia_peermem kernel
#     modules, which the driver-580 + OFED-26.04 stack here replaced with
#     DMA-BUF.  26.1 ships NVSHMEM 3.5.19, whose ibrc registers the symmetric
#     heap through mlx5dv DMA-BUF.  Single-node runs work with either, so this
#     only bites from 2 nodes on -- which is exactly the regime being measured.
#
#   * -gpu=cc90,cuda13.1.  cc90 = Hopper only; cuda13.1 must be spelled out
#     because the login nodes carry no NVIDIA driver, so nvfortran cannot infer
#     the toolkit version and falls back to an absent default.
#
#   * -gpu=mem:unified:nomanagedalloc is dropped.  That is a GH200 (hardware
#     coherent) setting; on x86 + H100 managed memory is migrated over PCIe and
#     means something quite different, so the benchmark is built separated.
#
#   * The site OpenMPI is used, not the one bundled with NVHPC, so -lmpi comes
#     from $(MPI_ROOT).  OMPI_FC swaps only the compiler: the wrapper still
#     links the MPI the site built (with nvfortran 24.1), which is what every
#     other library on this machine was built against.
#
# The link line mirrors gallope's arch/tsubame.in, which is known to link and
# run cuFFTMp here.  math_libs/lib64 is a symlink to 13.1/lib64.
#=======================================================================
NVHPC_ROOT   = /apps/t4/rhel9/isv/nvidia/hpc_sdk/Linux_x86_64/26.1
MPI_ROOT     = /apps/t4/rhel9/free/openmpi/5.0.2/nvhpc
NVSHMEM_ROOT = $(NVHPC_ROOT)/comm_libs/nvshmem

f90 := $(MPI_ROOT)/bin/mpif90
export OMPI_FC = $(NVHPC_ROOT)/compilers/bin/nvfortran

CFLAGS  = -O3 -Mfree -fast -Mextend -Mpreprocess -Minform=warn
CFLAGS += -Minfo=accel -cuda -cudalib=cufftmp -gpu=cc90,cuda13.1

LFLAGS  = -cuda -gpu=cc90,cuda13.1
LFLAGS += -L$(NVHPC_ROOT)/compilers/lib -lnvhpcwrapcufft -lnvhpcwrapcufftmp
LFLAGS += -L$(NVHPC_ROOT)/math_libs/lib64 -lcufftMp
# NVSHMEM 3.5.19 splits what 24.1 shipped as a single libnvshmem into a host
# library and a device archive, so config/Makefile.miyabi's -lnvshmem has no
# counterpart here; libcufftMp.so needs the host half.  Naming it explicitly
# (rather than relying on the module's LD_LIBRARY_PATH, which is what ld would
# otherwise search for it) is what keeps `make` working in a bare login shell.
LFLAGS += -L$(NVSHMEM_ROOT)/lib -lnvshmem_host
LFLAGS += -L$(MPI_ROOT)/lib -lmpi
# ... and rpath so the binary also runs without the modules loaded.
LFLAGS += -Wl,-rpath,$(NVSHMEM_ROOT)/lib -Wl,-rpath,$(NVHPC_ROOT)/math_libs/lib64

exe = cufftmp_r2c_c2r_pencils

all : $(exe)

$(exe) : $(exe).o
	$(f90) -o $@ $< $(LFLAGS)

%.o : %.f90
	$(f90) -c $< -o $@ $(CFLAGS)

.PHONY: clean
clean:
	@rm -rf *.mod *.o $(exe)
