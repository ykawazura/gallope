#!/bin/sh
#=======================================================================
# P3DFFT benchmark on TSUBAME4.0 -- Altair Grid Engine (AGE), NOT PBS.
#
# Run this script; do NOT qsub it -- it submits itself.  The group is charged
# through `qsub -g`, an option of TSUBAME's qsub wrapper only: as a `#$ -g`
# directive AGE rejects it, and AGE's own -P is a different namespace.
#
#   ./job.sh-tsubame                                # 1 node, 160 ranks, 1024^3
#   NODES=4 GRIDS=1024:2048 TRIAL=1 ./job.sh-tsubame
#   RESOURCE=cpu_16 NODES=1 GRIDS=256 ./job.sh-tsubame     # smoke test
#
# RESOURCE is cpu_160, not node_f: this is the CPU reference curve and node_f
# would charge for four idle H100.  cpu_160 is the largest CPU-only type here
# (160 of the node's 192 cores), and calliope uses it too, so the two CPU
# curves in Figs. 1 and 2 rest on the same allocation.  The x-axis unit stays
# "node" -- one cpu_160 is one node -- which is what makes the CPU and GPU
# curves comparable on this machine, where a node holds 4 GPUs but 192 cores.
#
# Knobs (lists are COLON-separated; AGE's -v is comma-separated, no spaces):
#   RESOURCE  cpu_160 | cpu_80 | cpu_40 | cpu_16 | node_f    [cpu_160]
#   NODES     nodes to allocate                              [1]
#   PPN       ranks per node                                 [NSLOTS/NHOSTS]
#   MODE      strong | weak                                  [strong]
#   GRIDS     strong: N for N^3;  weak: N^3 held per node    [1024:2048]
#   TRIAL     trial index, appended to the output file name  [1]
#   H_RT      wall-clock reservation, overrides the directive  [1:00:00]
#   OMP_NUM_THREADS  threads per rank                          [1]
#   NREPEAT   timed iterations inside the benchmark          [10]
#
# Three INDEPENDENT submissions per configuration (TRIAL=1,2,3) give the median
# and the min-max whiskers, so trials are never looped over in here.
#
# Output: results-202607/tsubame/{strong,weak}_scaling/<N>^3/rank<R>-node<M>-<T>
#=======================================================================
#$ -cwd
#$ -l h_rt=1:00:00
#$ -N p3dfft
#$ -j y

EXE_NAME=test_rand_f.x

TSUBAME_GROUP=tgh-26IDS
RESOURCE=${RESOURCE:-cpu_160}
NODES=${NODES:-1}
PPN=${PPN:-}
MODE=${MODE:-strong}
GRIDS=${GRIDS:-1024:2048}
TRIAL=${TRIAL:-1}
NREPEAT=${NREPEAT:-10}
# A command-line -l overrides the #$ directive above, so H_RT is what
# actually reserves the node.  Smoke tests should not book a whole hour.
H_RT=${H_RT:-1:00:00}
# P3DFFT here is built --enable-openmp, and left alone the runtime picks a
# thread count from the cores it can see -- 2 at cpu_16, more elsewhere -- so
# the ranks would oversubscribe and the count would change with the resource
# type.  The Miyabi runs report "Running on 1 threads"; pin it so the CPU
# curves on the two machines mean the same thing.
OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}
RESULTS=${RESULTS:-results-202607/tsubame}

if [ -z "${JOB_ID}" ]; then     # not under AGE yet -> submit ourselves
    exec qsub -g ${TSUBAME_GROUP} -l ${RESOURCE}=${NODES} -l h_rt=${H_RT} \
        -v "RESOURCE=${RESOURCE},NODES=${NODES},PPN=${PPN},MODE=${MODE},GRIDS=${GRIDS},TRIAL=${TRIAL},NREPEAT=${NREPEAT},H_RT=${H_RT},OMP_NUM_THREADS=${OMP_NUM_THREADS},RESULTS=${RESULTS}" \
        "$0"
fi

. ./config/env-tsubame.sh

ROOT=${PWD}
EXE=${ROOT}/${EXE_NAME}

export OMP_NUM_THREADS

ppn=${PPN:-$(( NSLOTS / NHOSTS ))}
nrank=$(( NHOSTS * ppn ))

# Host-memory guard.  driver_rand keeps BEG, FIN and CP (real) plus AEND
# (complex), i.e. about 32 bytes per grid point spread over the allocation,
# against ~368 GiB per cpu_160 node.  A run that does not fit would be killed
# by the OOM reaper halfway through and leave a truncated file that looks
# almost right, so refuse it up front -- and say so, rather than leaving a
# silent hole in the data set.
#
# 300 GB was too generous, for the same reason 60 GB was on the cuFFTMp side:
# the formula counts the arrays the driver declares and nothing else.  2048^3
# on one node estimates 274.9 GB, passed this guard, and was killed by the OOM
# reaper (signal 9) partway through; the same grid on two nodes estimates
# 137.4 GB and runs in 2.87 s/loop.  The true ceiling is between the two, so
# the cut is 200 GB -- taken from what was observed, not from the nominal
# 368 GiB, and it refuses exactly the case that was measured to die.
HOST_LIMIT=200000000000

echo "resource=${RESOURCE}=${NODES} hosts=${NHOSTS} slots=${NSLOTS}" \
     "ranks=${nrank} (${ppn}/node) mode=${MODE} grids=${GRIDS} trial=${TRIAL}"

for n in $(echo "${GRIDS}" | tr ':' ' '); do
    if [ "${MODE}" = weak ]; then
        k=0; p=1
        while [ ${p} -lt ${NHOSTS} ]; do p=$(( p * 2 )); k=$(( k + 1 )); done
        if [ ${p} -ne ${NHOSTS} ]; then
            echo "!! skip weak nodes=${NHOSTS}: not a power of two"
            continue
        fi
        nx=$(( n << ((k + 2) / 3) ))
        ny=$(( n << ((k + 1) / 3) ))
        nz=$(( n << (k / 3) ))
        out="${RESULTS}/weak_scaling/${n}^3/rank${nrank}-node${NHOSTS}-${TRIAL}"
    else
        nx=${n}; ny=${n}; nz=${n}
        out="${RESULTS}/strong_scaling/${n}^3/rank${nrank}-node${NHOSTS}-${TRIAL}"
    fi

    need=$(( 32 * nx * ny * nz / NHOSTS ))
    if [ ${need} -gt ${HOST_LIMIT} ]; then
        echo "!! skip ${nx}x${ny}x${nz} on ${NHOSTS} nodes: exceeds the host-memory guard"
        continue
    fi

    mkdir -p "$(dirname "${out}")"
    # Every run gets its own directory.  params.in is read from the process's
    # cwd, and the campaign runs many of these jobs against this one -cwd: a
    # shared params.in would let one job's grid size land in another job's
    # timing, and the trailing "rm -f" would delete a file a concurrent job had
    # just written, dropping it back to the built-in default grid.  The output
    # file name would still read correctly -- exactly the kind of plausible
    # wrong number that is unrecoverable at plot time.
    rundir="${ROOT}/runs/${JOB_ID}/${nx}x${ny}x${nz}-rank${nrank}-ppn${ppn}"
    mkdir -p "${rundir}"
    printf '%d %d %d %d\n' "${nx}" "${ny}" "${nz}" "${NREPEAT}" > "${rundir}/params.in"
    echo "== ${MODE} ${nx}x${ny}x${nz}  ranks=${nrank} nodes=${NHOSTS} -> ${out}"
    # -x LD_LIBRARY_PATH: ranks on the non-launching nodes are started by prted
    #     from a fresh login shell and never source config/env-tsubame.sh.
    # --mca coll_hcoll_enable 0: hcoll cannot attach to the sub-communicators
    #     P3DFFT builds and floods the log with save_coll_handlers failures.
    ( cd "${rundir}" && \
      mpirun -n ${nrank} --map-by ppr:${ppn}:node --bind-to core \
          -x LD_LIBRARY_PATH -x OMP_NUM_THREADS --mca coll_hcoll_enable 0 \
          "${EXE}" ) > "${out}" 2>&1
done

echo "done."
