!--------------------------------------------------!
!  BALANCED driven-echo PRODUCTION run (256^2 x 64,    !
!  nm=128). Resolution study to resolve the 128^2      !
!  ambiguity (plan 1-C-ii Stage 2 production target).  !
!                                                     !
!  128^2 finding: the balanced (sigma_c~0), strongly   !
!  nonlinear (chi~3), steady state shows a forward      !
!  Hermite cascade whose flux Gamma(m) is SENSITIVE to  !
!  the perp dissipation operator: k^8 gives flat        !
!  Gamma~0.92 (contaminated by a 15%% grid-scale UV     !
!  bottleneck), k^4 removes the bottleneck (5%%) and     !
!  gives a DECLINING Gamma~0.64. Operator sensitivity   !
!  = the 128^2 inertial range is too short to separate  !
!  injection/dissipation scales. 256^2 doubles k_perp,  !
!  lengthening the perp inertial range so Gamma(m)       !
!  becomes operator-insensitive and the echo verdict    !
!  (Gamma->0 fluidized vs flat forward cascade) is       !
!  decisive.                                             !
!                                                     !
!  Grid change vs echo128bal.in: nlx,nly 128->256.      !
!  nlz=64, nm=128, forcing IDENTICAL. Dissipation = the  !
!  CLEAN-recipe operators (fig_pileup_nm128 /            !
!  lowres64nm128_nu3.in: g perp k^4 / nexp_perp=2,        !
!  EM k^8) with ALL k-space (k_perp AND k_z) coeffs x5    !
!  vs that 64^2 recipe (g mu 100->500, EM perp 4d+3->     !
!  2.0d+4, EM parallel 4d+2->2.0d+3). x5 because the      !
!  grid-scale nonlinear cascade rate ~eps^1/3 k_max^2/3   !
!  grows ~2.5x from 64^2 to 256^2, so a k_max-normalized  !
!  coefficient held fixed under-damps; scaling ~k_max^2/3 !
!  keeps the dissipation scale below the grid. m-space    !
!  nu_hyper_m NOT scaled. (k^4 g operator has no          !
!  intrinsic bottleneck, unlike the old 256^2 k^8.) dt    !
!  UNCHANGED (2e-4): the binding CFL is the Hermite        !
!  streaming limit 1/(v_th*sqrt(2*nm)*kz_max), which is    !
!  set by nm,kz_max,v_th (all unchanged) and is INDEPENDENT !
!  of perp resolution; the perp CFL at 256^2 (~1e-3) is    !
!  looser. reset_method='decrement' auto-reduces if too big.!
!                                                     !
!  np=64 => [P_fft=8, P_m=8, P_s=1]: the VALIDATED 128^2    !
!  comm pattern (nly_local=32=2x the 128^2 slab, nm_local   !
!  =16 identical). An earlier np=128 [P_fft=16] launch      !
!  (job 2362634) HUNG at tt~0.75 after ~7500 clean steps    !
!  (cuFFTMp/MPI collective deadlock; P_fft=16 = the only    !
!  unvalidated variable) => reverted to the proven P_fft=8. !
!  6 h segments (max_wall_time=5.8); save_restart_intvl=1.0 !
!  checkpoints every 1 t so a transient hang loses <=1 t.   !
!  FRESH start (random IC): a different perp resolution  !
!  is a new equilibrium, cannot continue a 128^2 restart.!
!--------------------------------------------------!
&parallelization
  P_m = 8
  P_s = 1
/

&box_parameters
  lx = 1.0
  ly = 1.0
  lz = 1.0
  nlx = 256
  nly = 256
  nlz = 64
  nm  = 128
/

&time_parameters
  dt    = 2.0d-4
  nstep = 10000000
  cfl   = 0.5d0
  reset_method = 'decrement'
  increase_dt = 0e+0
/

&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

&operation_parameters
  nonlinear          = T
  write_hermite_flux = T
/

&physical_parameters
  ! Alfvenic (phi,psi) hyper-dissipation = the clean-recipe operators
  ! (fig_pileup_nm128 / lowres64nm128_nu3.in, k_perp^8 / k_z^8) with the
  ! coefficients raised x5 vs that 64^2 recipe (perp 4d+3->2.0d+4, parallel
  ! 4d+2->2.0d+3). x5 because the grid-scale nonlinear cascade rate grows
  ! ~k_max^2/3 (~2.5x) from 64^2 to 256^2, so the k_max-normalized coefficient
  ! must scale up ~k_max^2/3 to keep the same clean dissipation range.
  nupe_x      = 2.0d+4
  nupe_x_exp  = 4
  etape_x     = 2.0d+4
  etape_x_exp = 4
  nupe_z      = 2.0d+3
  nupe_z_exp  = 4
  etape_z     = 2.0d+3
  etape_z_exp = 4

  ! Kinetic (g) closure = the clean-recipe operator (fig_pileup_nm128 /
  ! lowres64nm128_nu3.in: perp k_perp^4 / nexp_perp=2, Hermite nu=3 m^6) with
  ! the PERP coefficient raised x5 vs that 64^2 recipe (mu 1.d2 -> 5.0d+2).
  ! The k^4 operator has no intrinsic hyperviscous bottleneck (unlike the old
  ! 256^2 k^8, which piled up regardless of coefficient), so x5 on mu genuinely
  ! lowers the dissipation scale and clears the residual perp pile-up that the
  ! fixed 64^2 coefficient leaves at 256^2 (grid-scale cascade rate ~2.5x
  ! higher). nu_hyper_m (m-space) is NOT scaled -- only k_perp / k_z coeffs.
  ! v_th is derived (= sqrt(beta_i)); no longer a namelist input. See params.F90.
  mu_hyper_perp = 5.0d+2
  nexp_perp     = 2
  nu_hyper_m    = 3.d0
  nexp_m        = 6
  beta_i        = 1.d0
  tau           = 1.d0
  Zcharge       = 1.d0
  alpha_root    = 1
/

&initial_condition
  init_type = 'random'
  init_seed = 7
/

!  elsasser => Alfven drive is (zppe, zmpe); g1 is the compressive
!  m=1 drive (Meyrand 2019). All three share the low-k stir shell
!  kmin..kmax. ene_inj_g fixes the compressive free-energy injection
!  rate (only the comm_m rank owning m=1 injects). xhl_inj = 0 => the
!  Alfvenic drive puts equal power into zppe and zmpe (balanced bath).
&force
  driven    = T
  elsasser  = .true.
  fix_power = .true.
  ene_inj   = 1.0d0
  xhl_inj   = 0.0d0
  ene_inj_g = 1.0d0
  kmin = 0.d0  0.d0  1.d0
  kmax = 1.0d0  1.0d0  2.d0
  nfields = 3
  stir_seed = 7
/
&forced_fields
  field_names = 'zppe'      , 'zmpe'      , 'g1'
  amplitudes  =  1.0        ,  1.0        ,  1.0
  frequencies = (0.9, -0.6) , (0.9, -0.6) , (0.9, -0.6)
/

&terminate
  ! Restart-chain strategy: 6 h PBS window, self-terminate at 5.8 h to
  ! flush a final restart + close the NetCDF. save_restart_intvl=2.0
  ! checkpoints every 2 t-units inside the segment for node-failure safety.
  max_wall_time   = 5.8
  terminate_file_name = 'terminate'
/

&diagnostics_parameters
  write_intvl         = 0.5d0
  write_intvl_2D      = 0.0d0
  write_intvl_3D      = 0.0d0
  SF2_nsample = 100000
/

&restart_parameters
  save_restart_intvl = 0.5d0
  restart_dir = './restart/'
/
