!--------------------------------------------------!
!  BALANCED driven-echo PRODUCTION run (256^2 x 64,    !
!  nm=128) -- CONTINUATION segment (init_type=restart, !
!  FRESH=0). Identical to echo256.in except the initial !
!  condition is read from ./restart/. See echo256.in    !
!  header for the full rationale (resolution study to   !
!  resolve the 128^2 operator-sensitivity ambiguity).   !
!--------------------------------------------------!
&parallelization
  P_m = 8
  P_s = 1
/

&box_parameters
  lx = 1.0
  ly = 1.0
  lz = 1.0
  nlx = 256
  nly = 256
  nlz = 64
  nm  = 128
/

&time_parameters
  ! Seed dt at the observed 256^2 steady CFL (~4.8e-5 at mvx~14,mvy~20;
  ! perp CFL dt=cfl*dlx/mv tightens 2x vs 128^2 as dlx=lx/nlx halves).
  ! Starting a continuation at 2e-4 would re-run the 2e-4->4e-5 decrement
  ! transient every segment (the hang-prone spin-up band); seeding near
  ! the answer avoids it. reset_method='decrement' still adapts as needed.
  dt    = 4.0d-5
  nstep = 10000000
  cfl   = 0.5d0
  reset_method = 'decrement'
  increase_dt = 0e+0
/

&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

&operation_parameters
  nonlinear          = T
  write_hermite_flux = T
/

&physical_parameters
  ! Dissipation = the CLEAN recipe OPERATORS (fig_pileup_nm128 /
  ! lowres64nm128_nu3.in: g perp k^4 / nexp_perp=2, EM k^8) with ALL k-space
  ! (k_perp AND k_z) COEFFICIENTS raised x5 vs that 64^2 recipe. Why x5: the
  ! k_max-normalized coefficient fixes the grid-scale DAMPING rate, but the
  ! pile-up criterion is damping-rate vs nonlinear-cascade-rate at the grid
  ! scale, and the latter (~eps^1/3 k_max^2/3) grows ~2.5x from 64^2 to 256^2
  ! (4x longer perp inertial range). Holding the coefficient fixed under-damps
  ! -> residual pile-up; scaling it ~k_max^2/3 (>=2.5x) keeps the dissipation
  ! scale below the grid. x5 gives margin. Operator orders (k^4/k^8/m^6) and
  ! the Hermite m-dissipation (nu_hyper_m, m-space, NOT a k-direction) unchanged.
  nupe_x      = 2.0d+4     ! 4d+3 (recipe) x5   EM phi perp, k_perp^8
  nupe_x_exp  = 4
  etape_x     = 2.0d+4     ! 4d+3 (recipe) x5   EM psi perp
  etape_x_exp = 4
  nupe_z      = 2.0d+3     ! 4d+2 (recipe) x5   EM phi parallel, k_z^8
  nupe_z_exp  = 4
  etape_z     = 2.0d+3     ! 4d+2 (recipe) x5   EM psi parallel
  etape_z_exp = 4

  ! v_th is derived (= sqrt(beta_i)); no longer a namelist input. See params.F90.
  mu_hyper_perp = 5.0d+2     ! 1.d2 (recipe) x5   g perp hyperviscosity, k_perp^4 (nexp_perp=2)
  nexp_perp     = 2          ! k_perp^4 (gentle, no intrinsic bottleneck); operator unchanged
  nu_hyper_m    = 3.d0       ! m-space Hermite hypercollision; NOT scaled (k-directions only)
  nexp_m        = 6
  beta_i        = 1.d0
  tau           = 1.d0
  Zcharge       = 1.d0
  alpha_root    = 1
/

&initial_condition
  init_type = 'restart'
  init_seed = 7
/

&force
  driven    = T
  elsasser  = .true.
  fix_power = .true.
  ene_inj   = 1.0d0
  xhl_inj   = 0.0d0
  ene_inj_g = 1.0d0
  kmin = 0.d0  0.d0  1.d0
  kmax = 1.0d0  1.0d0  2.d0
  nfields = 3
  stir_seed = 7
/
&forced_fields
  field_names = 'zppe'      , 'zmpe'      , 'g1'
  amplitudes  =  1.0        ,  1.0        ,  1.0
  frequencies = (0.9, -0.6) , (0.9, -0.6) , (0.9, -0.6)
/

&terminate
  max_wall_time   = 5.8
  terminate_file_name = 'terminate'
/

&diagnostics_parameters
  write_intvl         = 0.5d0
  write_intvl_2D      = 0.0d0
  write_intvl_3D      = 0.0d0
  SF2_nsample = 100000
/

&restart_parameters
  save_restart_intvl = 0.5d0
  restart_dir = './restart/'
/
