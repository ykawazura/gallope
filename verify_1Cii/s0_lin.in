!--------------------------------------------------!
!  1-C-ii Stage 0 (LINEAR telescoping sanity).      !
!  nonlinear=F => the diagnostic grad_par S_m        !
!  reduces to the pure spectral zi*kz*S_m (no FFT,   !
!  no dealiasing), so this isolates the Hermite      !
!  coefficient / weight / sign logic of eq (9).      !
!  init_type='random' populates ALL local moments    !
!  g_m (loop over mm with an independent random real  !
!  field each), giving a broadband, non-trivial per- !
!  rung source. The per-rung sources telescope:      !
!    sum_{m=0}^{nm-1} src_m(k) = 0  at every k       !
!  (weighted antisymmetry w_m cp_m = w_{m+1} cm_{m+1}!
!  + ghost g_nm=0), so the top cumulative slot        !
!    Gamma_{top}(k) = sum_all src_m = 0.             !
!  Pure spectral arithmetic => residual ~1e-13.      !
!  nm=8, 16^3, P_m=1 (nproc=4 => P_fft=4).           !
!--------------------------------------------------!
&parallelization
  P_m = 1
  P_s = 1
/

&box_parameters
  lx = 1.0
  ly = 1.0
  lz = 1.0
  nlx = 16
  nly = 16
  nlz = 16
  nm  = 8
/

&time_parameters
  dt    = 5.0d-3
  nstep = 40
  cfl   = 2.0d0
  reset_method = 'decrement'
  increase_dt = 0e+0
/

&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

&operation_parameters
  nonlinear          = F
  write_hermite_flux = T
/

&physical_parameters
  nupe_x      = 0.d0
  nupe_x_exp  = 4
  etape_x     = 0.d0
  etape_x_exp = 4
  nupe_z      = 0.d0
  nupe_z_exp  = 4
  etape_z     = 0.d0
  etape_z_exp = 4

  v_th          = 1.d0
  mu_hyper_perp = 0.d0
  nexp_perp     = 4
  nu_hyper_m    = 0.d0
  nexp_m        = 6
  beta_i        = 1.d0
  tau           = 1.d0
  Zcharge       = 1.d0
  alpha_root    = 1
/

&initial_condition
  init_type = 'random'
  init_seed = 42
/

&force
  driven = F
/

&terminate
  max_wall_time   = 0.5
  terminate_file_name = 'terminate'
/

&diagnostics_parameters
  write_intvl         = 0.02d0
  write_intvl_2D      = 0.0d0
  write_intvl_3D      = 0.0d0
  SF2_nsample = 100000
/

&restart_parameters
  save_restart_intvl = 100.0d0
  restart_dir = './restart/'
/
