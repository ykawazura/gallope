!--------------------------------------------------!
!  1-C-ii PRODUCTION echo run (Reduced 128^2 x 64,    !
!  nm=32). Driven Alfvenic turbulence with a passive  !
!  kinetic g cascade; the deliverable is the          !
!  time-averaged Hermite free-energy flux Gamma_m(k)  !
!  (eq 9), expected ~0 across the inertial range      !
!  (stochastic echo / fluidization, Meyrand 2019).    !
!                                                     !
!  Config confirmed by prod128_smoke (job 2352129):   !
!  clean run at full resolution, cfl=0.5 (empirically !
!  calibrated, lesson L16), 26.2 ms/step at np=32     !
!  (P_fft=8, P_m=4, P_s=1). Dissipation coefficients  !
!  are UNCHANGED from the 64^2 runs (all hyperdiff    !
!  terms normalized to k_max / m=nm, denominators     !
!  scale with resolution -> no rescale needed).       !
!  dt starts 2e-4 and the auto-limiter rides it down  !
!  to ~1e-4 as the bath develops. max_wall_time=2.5h  !
!  reaches t~30 (steady state by t~10 + a wide        !
!  averaging window). Restart every 10 time units so  !
!  the run can be resumed/extended.                   !
!--------------------------------------------------!
&parallelization
  P_m = 4
  P_s = 1
/

&box_parameters
  lx = 1.0
  ly = 1.0
  lz = 1.0
  nlx = 128
  nly = 128
  nlz = 64
  nm  = 32
/

&time_parameters
  dt    = 2.0d-4
  nstep = 1000000
  cfl   = 0.5d0
  reset_method = 'decrement'
  increase_dt = 0e+0
/

&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

&operation_parameters
  nonlinear          = T
  write_hermite_flux = T
/

&physical_parameters
  ! Alfvenic (phi,psi) hyper-dissipation keeps the RMHD bath stable.
  nupe_x      = 4d+3
  nupe_x_exp  = 4
  etape_x     = 4d+3
  etape_x_exp = 4
  nupe_z      = 4d+1
  nupe_z_exp  = 4
  etape_z     = 4d+1
  etape_z_exp = 4

  ! Kinetic (g) closure: perp hyperviscosity mu at k_perp,max and a small
  ! Hermite hypercollision nu at m=nm (both steep so the inertial range is
  ! left clean; m=0 is undamped).
  v_th          = 1.d0
  mu_hyper_perp = 1.d1
  nexp_perp     = 4
  nu_hyper_m    = 1.d0
  nexp_m        = 6
  beta_i        = 1.d0
  tau           = 1.d0
  Zcharge       = 1.d0
  alpha_root    = 1
/

&initial_condition
  init_type = 'random'
  init_seed = 7
/

!  elsasser => forced_fields are (zppe, zmpe); large-scale Alfvenic drive.
&force
  driven    = T
  elsasser  = .true.
  fix_power = .true.
  ene_inj   = 1.0d0
  xhl_inj   = 0.8d0
  kmin = 0.d0  0.d0  1.d0
  kmax = 1.0d0  1.0d0  2.d0
  nfields = 2
  stir_seed = 7
/
&forced_fields
  field_names = 'zppe'      , 'zmpe'
  amplitudes  =  1.0        ,  1.0
  frequencies = (0.9, -0.6) , (0.9, -0.6)
/

&terminate
  max_wall_time   = 2.5
  terminate_file_name = 'terminate'
/

&diagnostics_parameters
  write_intvl         = 0.25d0
  write_intvl_2D      = 0.0d0
  write_intvl_3D      = 0.0d0
  SF2_nsample = 100000
/

&restart_parameters
  save_restart_intvl = 10.0d0
  restart_dir = './restart/'
/
