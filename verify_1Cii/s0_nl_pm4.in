!--------------------------------------------------!
!  1-C-ii Stage 0 (FULL telescoping, P_m=4 test).   !
!  Identical physics to s0_nl_pm1 but the Hermite    !
!  axis is split over comm_m (P_m=4). Run with       !
!  nproc=16 => P_fft=4 (SAME cuFFTMp slab as pm1),   !
!  so g/Psi are bit-identical (1-B) and only the     !
!  comm_fm assembly of Gamma_m differs. This tests   !
!  that (a) telescoping still holds with the per-     !
!  rung sources computed on different ranks and       !
!  reduced together, and (b) Gamma_m matches the      !
!  P_m=1 reference to reduction-order (ULP) tol.     !
!  The proc0 prefix-sum over global m runs AFTER the !
!  full comm_fm reduction, so it is split-agnostic.  !
!  nm=8, 16^3, P_m=4 (nproc=16 => P_fft=4).          !
!--------------------------------------------------!
&parallelization
  P_m = 4
  P_s = 1
/

&box_parameters
  lx = 1.0
  ly = 1.0
  lz = 1.0
  nlx = 16
  nly = 16
  nlz = 16
  nm  = 8
/

&time_parameters
  dt    = 5.0d-3
  nstep = 40
  cfl   = 2.0d0
  reset_method = 'decrement'
  increase_dt = 0e+0
/

&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

&operation_parameters
  nonlinear          = T
  write_hermite_flux = T
/

&physical_parameters
  nupe_x      = 4d+3
  nupe_x_exp  = 4
  etape_x     = 4d+3
  etape_x_exp = 4
  nupe_z      = 4d+1
  nupe_z_exp  = 4
  etape_z     = 4d+1
  etape_z_exp = 4

  v_th          = 1.d0
  mu_hyper_perp = 0.d0
  nexp_perp     = 4
  nu_hyper_m    = 0.d0
  nexp_m        = 6
  beta_i        = 1.d0
  tau           = 1.d0
  Zcharge       = 1.d0
  alpha_root    = 1
/

&initial_condition
  init_type = 'random'
  init_seed = 42
/

&force
  driven = F
/

&terminate
  max_wall_time   = 0.5
  terminate_file_name = 'terminate'
/

&diagnostics_parameters
  write_intvl         = 0.02d0
  write_intvl_2D      = 0.0d0
  write_intvl_3D      = 0.0d0
  SF2_nsample = 100000
/

&restart_parameters
  save_restart_intvl = 100.0d0
  restart_dir = './restart/'
/
