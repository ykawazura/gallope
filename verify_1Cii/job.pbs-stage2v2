#!/bin/sh -l
#------ qsub option --------#
#PBS -q regular-g
#PBS -l select=16:mpiprocs=1
#PBS -l walltime=00:20:00
#PBS -W group_list=gr96
#PBS -j oe
#PBS -N krmhd_s2v2

#=====================================================================
#  1-C-ii Stage 2 SMOKE v2 (CFL-confirmation): same driven-turbulence
#  KRMHD run as v1 but with a small explicit dt (5e-4) and cfl=1.0 to
#  confirm that the v1 blow-up was a streaming-CFL instability (not a
#  bug) and to expose the echo signature. Post-processes with the same
#  check_stage2.py.
#=====================================================================
module load nvidia
module load nv-hpcx
module load hdf5
module load netcdf
module load netcdf-fortran

set -u
cd ${PBS_O_WORKDIR}

ROOT=${PBS_O_WORKDIR}
BIN=${ROOT}/../gallope
RUN=${ROOT}/runs_stage2v2
rm -rf "${RUN}"
mkdir -p "${RUN}/restart" "${RUN}/out2d" "${RUN}/out3d"
cp "${ROOT}/stage2_smoke_v2.in" "${RUN}/gallope.in"

echo "================ Stage 2 smoke v2 run ================"
t0=$(date +%s)
( cd "${RUN}" && mpirun -np 16 "${BIN}" <gallope.in >out.std 2>&1 )
rc=$?
t1=$(date +%s)
echo "[driver] stage2_smoke_v2 done, rc=${rc}, wall=$((t1 - t0))s"

echo
echo "----- tail of out.std -----"
tail -25 "${RUN}/out.std"

echo
echo "================ Stage 2 smoke v2 analysis ================"
NC=$(ls "${RUN}"/*.out.nc 2>/dev/null | head -1)
if [ -z "${NC}" ]; then
  echo "ERROR: no NetCDF output found in ${RUN}"
  exit 1
fi
python3 "${ROOT}/check_stage2.py" "${NC}" 2>&1
echo "======================================================="
