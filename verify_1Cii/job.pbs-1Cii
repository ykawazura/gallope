#!/bin/sh -l
#------ qsub option --------#
#PBS -q regular-g
#PBS -l select=16:mpiprocs=1
#PBS -l walltime=01:00:00
#PBS -W group_list=gr96
#PBS -j oe
#PBS -N krmhd_1Cii

#=====================================================================
#  Milestone 1-C-ii verification driver: the gated Hermite free-energy
#  flux Gamma_m(k_perp) (Meyrand eq 9), written to NetCDF only when
#  write_hermite_flux=T. One 16-node allocation runs 4 cases:
#    s0_lin    (np=4,  P_m=1) nonlinear=F random, nm=8  -- linear telescoping
#    s0_nl_pm1 (np=4,  P_m=1) nonlinear=T random, nm=8  -- full telescoping + ref
#    s0_nl_pm4 (np=16, P_m=4) nonlinear=T random, nm=8  -- full telescoping + P_m
#    stage1    (np=4,  P_m=1) nonlinear=F single_mode, nm=16 -- forward-flux sign
#
#  Checks (extracted from gallope.out.nc via ncdump + check_1Cii.py):
#    (0a) TELE_LIN      : binned top-m slot ~0 per k_perp, LINEAR streaming
#                         (isolates Hermite coeff/weight/sign, no FFT).
#    (0b) TELE_NL_KINT  : k-integrated top slot Gamma(nm-1) ~0, NONLINEAR
#                         bracket, evolved recs. Binning-immune telescoping
#                         (the binned per-k top slot is O(1) BY DESIGN --
#                         the {Psi,S_m} bracket transfers energy across
#                         k_perp, so it telescopes only after the k-sum;
#                         polar binning drops Cartesian corners, hence the
#                         unbinned Gamma_m_kint accumulator).
#    (0c) TELE_LIN_KINT : k-integrated top slot ~0, LINEAR (sanity).
#    (0d) PMREL         : Gamma_m matches across P_m=1 vs P_m=4 (split asm).
#    (0e) ORDERING      : reshape self-check (single_mode energy at k_perp=0).
#    (1)  SIGN_PEAK     : linear phase-mixing => forward Hermite flux > 0.
#    (i)  BUDGET_NL     : informational dW_free/dt = -Gamma_kint(nm-1).
#=====================================================================
module load nvidia
module load nv-hpcx
module load hdf5
module load netcdf
module load netcdf-fortran

set -u
cd ${PBS_O_WORKDIR}

ROOT=${PBS_O_WORKDIR}
BIN=${ROOT}/../gallope          # KRMHD binary built in the repo root
RUN=${ROOT}/runs
rm -rf "${RUN}"
mkdir -p "${RUN}"

# ---- helper: run one case in its own subdir ------------------------
run_case () {   # $1=name  $2=np  $3=infile
  name=$1; np=$2; inf=$3
  d="${RUN}/${name}"
  mkdir -p "${d}/restart" "${d}/out2d" "${d}/out3d"
  cp "${ROOT}/${inf}" "${d}/gallope.in"
  ( cd "${d}" && mpirun -np "${np}" "${BIN}" <gallope.in >out.std 2>&1 )
  echo "[driver] ${name} (np=${np}) done, rc=$?"
}

ncof () { ls "${RUN}/$1"/*.out.nc 2>/dev/null | head -1; }  # locate NetCDF output

echo "================ 1-C-ii verification runs ================"
run_case s0_lin    4  s0_lin.in
run_case s0_nl_pm1 4  s0_nl_pm1.in
run_case s0_nl_pm4 16 s0_nl_pm4.in
run_case stage1    4  stage1.in

echo
echo "================ 1-C-ii verification summary ============="

pass=0; fail=0
verdict () { # $1=label $2=cond(0=pass)
  if [ "$2" -eq 0 ]; then echo "PASS  $1"; pass=$((pass+1));
  else echo "FAIL  $1"; fail=$((fail+1)); fi
}

# ---- extract all metrics with the python/ncdump post-processor -----
python3 "${ROOT}/check_1Cii.py" \
    "$(ncof s0_lin)" "$(ncof s0_nl_pm1)" "$(ncof s0_nl_pm4)" "$(ncof stage1)" \
    > "${RUN}/metrics.txt" 2>&1
echo "----- check_1Cii.py output -----"
cat "${RUN}/metrics.txt"
echo "--------------------------------"
get () { awk -v k="$1" '$1==k{print $2}' "${RUN}/metrics.txt"; }

TELE_LIN=$(get TELE_LIN)
TELE_LIN_KINT=$(get TELE_LIN_KINT)
TELE_NL_KINT=$(get TELE_NL_KINT)
BUDGET_NL=$(get BUDGET_NL)
PMREL=$(get PMREL)
ORDERING=$(get ORDERING)
SIGN_PEAK=$(get SIGN_PEAK)

# ---------- (0a) linear telescoping, binned per-k (coeff/weight/sign) ----------
awk -v v="${TELE_LIN}" 'BEGIN{exit !(v+0<1.0e-9 && v!="")}'
verdict "(0a) TELE_LIN binned top-m slot ~0 per-k, LINEAR (rtol<1e-9)" $?

# ---------- (0b) nonlinear bracket telescoping, k-integrated (binning-immune) ----------
awk -v v="${TELE_NL_KINT}" 'BEGIN{exit !(v+0<1.0e-9 && v!="")}'
verdict "(0b) TELE_NL_KINT k-int top slot ~0, {Psi,S_m} bracket (rtol<1e-9)" $?

# ---------- (0c) linear telescoping, k-integrated (sanity) ----------
awk -v v="${TELE_LIN_KINT}" 'BEGIN{exit !(v+0<1.0e-9 && v!="")}'
verdict "(0c) TELE_LIN_KINT k-int top slot ~0, LINEAR (rtol<1e-9)" $?

# ---------- (0d) P_m invariance of Gamma_m (split assembly) ----------
awk -v v="${PMREL}" 'BEGIN{exit !(v+0<1.0e-9 && v!="")}'
verdict "(0d) PMREL Gamma_m P_m-invariant (pm1==pm4, rtol<1e-9)" $?

# ---------- (0e) reshape ordering self-check ----------
awk -v v="${ORDERING}" 'BEGIN{exit !(v+0<1.0e-12 && v!="")}'
verdict "(0e) ORDERING single_mode energy at k_perp=0 only (<1e-12)" $?

# ---------- (1) forward-cascade sign (linear phase mixing) ----------
awk -v v="${SIGN_PEAK}" 'BEGIN{exit !(v+0>0.0 && v!="")}'
verdict "(1) SIGN_PEAK forward Hermite flux Gamma_m > 0 (linear)" $?

# ---------- (i) budget closure dW/dt = -Gamma_kint(nm-1) (informational) ----------
echo "INFO  BUDGET_NL (dW/dt + Gamma_kint_top)/peak = ${BUDGET_NL}"

echo
echo "TOTAL: ${pass} passed, ${fail} failed"
echo "======================================================="
