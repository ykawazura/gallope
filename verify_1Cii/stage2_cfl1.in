!--------------------------------------------------!
!  1-C-ii CFL-calibration run (cfl = 1.0).           !
!  Both code fixes are in place: (1) the streaming    !
!  CFL now includes the nonlinear magnetic streaming  !
!  {psi,S_m}, and (2) the dt-reset loops down to      !
!  <= dt_cfl in one call. The residual cfl=2.0 blow-  !
!  up was traced to the advective dt_cfl formula      !
!  itself being ~2x optimistic (it uses 1/dl as the   !
!  effective wavenumber, whereas the 2/3-dealiased    !
!  field reaches (2/3)*k_Nyquist ~ 2.09/dl); RMHD     !
!  absorbs this in its cfl calibration but the        !
!  kinetic g with streaming coupling needs cfl<~1.    !
!  This run drives the same turbulence LONG (past the !
!  t~5.5 danger zone where cfl=2.0 died) to confirm   !
!  cfl=1.0 stays bounded and still shows the echo.    !
!  Everything else identical to stage2_smoke.in.      !
!--------------------------------------------------!
&parallelization
  P_m = 4
  P_s = 1
/

&box_parameters
  lx = 1.0
  ly = 1.0
  lz = 1.0
  nlx = 64
  nly = 64
  nlz = 32
  nm  = 16
/

&time_parameters
  dt    = 5.0d-4
  nstep = 500000
  cfl   = 1.0d0
  reset_method = 'decrement'
  increase_dt = 0e+0
/

&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

&operation_parameters
  nonlinear          = T
  write_hermite_flux = T
/

&physical_parameters
  ! Alfvenic (phi,psi) hyper-dissipation keeps the RMHD bath stable.
  nupe_x      = 4d+3
  nupe_x_exp  = 4
  etape_x     = 4d+3
  etape_x_exp = 4
  nupe_z      = 4d+1
  nupe_z_exp  = 4
  etape_z     = 4d+1
  etape_z_exp = 4

  ! Kinetic (g) closure: perp hyperviscosity mu at k_perp,max and a small
  ! Hermite hypercollision nu at m=nm (both steep so the inertial range is
  ! left clean; m=0 is undamped).
  v_th          = 1.d0
  mu_hyper_perp = 1.d1
  nexp_perp     = 4
  nu_hyper_m    = 1.d0
  nexp_m        = 6
  beta_i        = 1.d0
  tau           = 1.d0
  Zcharge       = 1.d0
  alpha_root    = 1
/

&initial_condition
  init_type = 'random'
  init_seed = 7
/

!  elsasser => forced_fields are (zppe, zmpe); large-scale Alfvenic drive.
&force
  driven    = T
  elsasser  = .true.
  fix_power = .true.
  ene_inj   = 1.0d0
  xhl_inj   = 0.8d0
  kmin = 0.d0  0.d0  1.d0
  kmax = 1.0d0  1.0d0  2.d0
  nfields = 2
  stir_seed = 7
/
&forced_fields
  field_names = 'zppe'      , 'zmpe'
  amplitudes  =  1.0        ,  1.0
  frequencies = (0.9, -0.6) , (0.9, -0.6)
/

&terminate
  max_wall_time   = 0.30
  terminate_file_name = 'terminate'
/

&diagnostics_parameters
  write_intvl         = 0.25d0
  write_intvl_2D      = 0.0d0
  write_intvl_3D      = 0.0d0
  SF2_nsample = 100000
/

&restart_parameters
  save_restart_intvl = 100.0d0
  restart_dir = './restart/'
/
