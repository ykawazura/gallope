!--------------------------------------------------!
!  1-B linear Landau / Hermite-recurrence test.     !
!  nonlinear=F  => phi/psi are decoupled from g, so !
!  g evolves under pure parallel free-streaming      !
!  -v_th d_z S_m only. init_type='single_mode' seeds !
!  ONLY g_0 at (kx=0, ky=0, kz(2)); with lz=2*pi the !
!  single parallel mode is kz=1, and v_th=1, so      !
!  g0var(0)=1 exactly (one global mode).             !
!  Collisionless (nu_hyper_m=0): the m=0 moment      !
!  (g0var) first Landau-damps as it phase-mixes up   !
!  the Hermite ladder to a deep null, then RECURS    !
!  when the packet reflects off the nm=16 truncation !
!  (recurrence on the order of sqrt(2*nm)/(kz*v_th); !
!  empirically the deep null is near t ~ 2 sqrt(2 nm)!
!  ~ 11 here, with the recurrence bump just after).  !
!  The CONSERVED quantity is the eq (6) free energy  !
!  W_eq6 = 1/2 sum|g_m|^2 + 1/2 alpha |g_0|^2, NOT   !
!  Wg_tot alone: as g_0 phase-mixes, the alpha|g_0|^2!
!  field energy converts into sum|g_m|^2, so Wg_tot  !
!  RISES while W_eq6 stays flat. Compare landau_nu.in!
!--------------------------------------------------!
&parallelization
  P_m = 1
  P_s = 1
/

&box_parameters
  lx = 1.0
  ly = 1.0
  lz = 6.283185307179586d0
  nlx = 8
  nly = 8
  nlz = 16
  nm  = 16
/

&time_parameters
  dt    = 1.0d-2
  nstep = 3000
  cfl   = 2.0d0
  reset_method = 'decrement'
  increase_dt = 0e+0
/

&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

&operation_parameters
  nonlinear = F
/

&physical_parameters
  nupe_x      = 0.d0
  nupe_x_exp  = 4
  etape_x     = 0.d0
  etape_x_exp = 4
  nupe_z      = 0.d0
  nupe_z_exp  = 4
  etape_z     = 0.d0
  etape_z_exp = 4

  v_th          = 1.d0
  mu_hyper_perp = 0.d0
  nexp_perp     = 4
  nu_hyper_m    = 0.d0
  nexp_m        = 6
  beta_i        = 1.d0
  tau           = 1.d0
  Zcharge       = 1.d0
  alpha_root    = 1
/

&initial_condition
  init_type = 'single_mode'
  init_seed = 42
/

&force
  driven = F
/

&terminate
  max_wall_time   = 0.5
  terminate_file_name = 'terminate'
/

&diagnostics_parameters
  write_intvl         = 0.1d0
  write_intvl_2D      = 0.0d0
  write_intvl_3D      = 0.0d0
  SF2_nsample = 100000
/

&restart_parameters
  save_restart_intvl = 100.0d0
  restart_dir = './restart/'
/
