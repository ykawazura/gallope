#!/bin/sh -l
#------ qsub option --------#
#PBS -q regular-g
#PBS -l select=16:mpiprocs=1
#PBS -l walltime=01:00:00
#PBS -W group_list=gr96
#PBS -j oe
#PBS -N krmhd_1C

#=====================================================================
#  Milestone 1-C-i verification driver: the new permanent NetCDF g
#  diagnostics (per-m Hermite spectrum g2_bin, per-m free energy W_m,
#  total free energy W_free = Meyrand eq 6). One 16-node allocation runs:
#    pm1        (np=4,  P_m=1) turbulent, nm=4  -- P_m-invariance ref
#    pm4        (np=16, P_m=4) turbulent, nm=4  -- P_m-invariance test
#    landau_nu0 (np=4,  P_m=1) collisionless single-mode, nm=16
#
#  Checks (extracted from gallope.out.nc via ncdump + check_1C.py):
#    (i)   W_free(t) drift < 0.5%   -- eq(6) invariant, re-confirms 1-B (~2e-9)
#    (ii)  sum_bins g2_bin == sum_m W_m (single-mode keeps all energy at
#          kperp=0 => no top-bin truncation => exact internal consistency)
#    (iii) g2_bin / W_free match between P_m=1 and P_m=4 (g is bit-identical
#          from 1-B; only the comm_fm reduction ORDER differs => ULP-level)
#=====================================================================
module load nvidia
module load nv-hpcx
module load hdf5
module load netcdf
module load netcdf-fortran

set -u
cd ${PBS_O_WORKDIR}

ROOT=${PBS_O_WORKDIR}
BIN=${ROOT}/../gallope          # KRMHD binary built in the repo root
RUN=${ROOT}/runs
rm -rf "${RUN}"
mkdir -p "${RUN}"

# ---- helper: run one case in its own subdir ------------------------
run_case () {   # $1=name  $2=np  $3=infile
  name=$1; np=$2; inf=$3
  d="${RUN}/${name}"
  mkdir -p "${d}/restart" "${d}/out2d" "${d}/out3d"
  cp "${ROOT}/${inf}" "${d}/gallope.in"
  ( cd "${d}" && mpirun -np "${np}" "${BIN}" <gallope.in >out.std 2>&1 )
  echo "[driver] ${name} (np=${np}) done, rc=$?"
}

ncof () { ls "${RUN}/$1"/*.out.nc 2>/dev/null | head -1; }  # locate NetCDF output

echo "================ 1-C-i verification runs ================"
run_case pm1        4  pm1.in
run_case pm4        16 pm4.in
run_case landau_nu0 4  landau_nu0.in

echo
echo "================ 1-C-i verification summary ============="

pass=0; fail=0
verdict () { # $1=label $2=cond(0=pass)
  if [ "$2" -eq 0 ]; then echo "PASS  $1"; pass=$((pass+1));
  else echo "FAIL  $1"; fail=$((fail+1)); fi
}

# ---- extract all metrics with the python/ncdump post-processor -----
python3 "${ROOT}/check_1C.py" "$(ncof landau_nu0)" "$(ncof pm1)" "$(ncof pm4)" \
    > "${RUN}/metrics.txt" 2>&1
echo "----- check_1C.py output -----"
cat "${RUN}/metrics.txt"
echo "------------------------------"
get () { awk -v k="$1" '$1==k{print $2}' "${RUN}/metrics.txt"; }

DRIFT=$(get DRIFT)
INTERNAL=$(get INTERNAL)
WFREE_REL=$(get WFREE_REL)
G2_MAXREL=$(get G2_MAXREL)

# ---------- (i) eq(6) free-energy conservation (collisionless) ----------
awk -v d="${DRIFT}" 'BEGIN{exit !(d+0<5.0e-3 && d!="")}'
verdict "(i) NetCDF W_free drift < 0.5% (collisionless landau_nu0)" $?

# ---------- (ii) internal consistency: binned spectrum vs per-m W ----------
awk -v v="${INTERNAL}" 'BEGIN{exit !(v+0<1.0e-10 && v!="")}'
verdict "(ii) sum_bins g2_bin == sum_m W_m (single-mode, exact)" $?

# ---------- (iii) P_m invariance (pm1 vs pm4, reduction-order tol) ----------
awk -v v="${WFREE_REL}" 'BEGIN{exit !(v+0<1.0e-9 && v!="")}'
verdict "(iii) W_free P_m-invariant (pm1==pm4, rtol<1e-9)" $?
awk -v v="${G2_MAXREL}" 'BEGIN{exit !(v+0<1.0e-9 && v!="")}'
verdict "(iii) g2_bin P_m-invariant (pm1==pm4, rtol<1e-9)" $?

echo
echo "TOTAL: ${pass} passed, ${fail} failed"
echo "======================================================="
