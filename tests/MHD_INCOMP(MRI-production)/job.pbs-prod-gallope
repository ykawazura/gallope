#!/bin/sh -l
#PBS -q regular-g
#PBS -l select=16:mpiprocs=1
#PBS -l walltime=48:00:00
#PBS -W group_list=gr96
#PBS -j oe
#PBS -N mri-prod-g
#=====================================================================
#  Nonlinear MRI production run, Gallope half.  512 x 512 x 256,
#  shearing box, post-fix code (gallope 4eea7cf).  Target t ~ 700 so
#  that the published averaging window t in [200, 676] is covered.
#
#  Placement: one rank per node, one GH200 per node.  NOTE the absence
#  of `:ompthreads=1` -- with it the 16 rank run hung between
#  "Solving MHD_INCOMP" and "Initialization done"; without it the same
#  binary, grid and input reach the main loop in 10 s (job 2487620,
#  cases g16_plain_prod / g16_n16_128).  The known-good 128 node
#  scaling script omits it too.
#
#  Cost: 0.087 s/step measured over 20 steps at this grid and node
#  count, so 47 h buys about 1.9e6 steps.  The saturated CFL time step
#  is not known in advance, so the run is wall-time bounded rather than
#  step bounded: `max_wall_time = 47.0` in gallope.in makes the code
#  write a restart and exit cleanly about an hour before the scheduler
#  would kill it.
#
#  Resubmitting this script continues the run.  That needs care,
#  because io.F90 opens the netCDF diagnostics with NF90_CLOBBER and
#  no restart branch (src/model/MHD_INCOMP/io.F90:294), so a second leg
#  would otherwise destroy the first leg's time history.  Everything
#  except restart/ is therefore archived into legs/leg<N>/ first, and
#  the time series are concatenated in post-processing.
#=====================================================================
module load nvidia
module load nv-hpcx
module load hdf5
module load netcdf
module load netcdf-fortran

set -u
cd ${PBS_O_WORKDIR}

d="prod_gallope"
mkdir -p "${d}/restart" "${d}/out2d" "${d}/out3d" "${d}/legs"
ln -sf ../gallope "${d}/gallope"

# legs/ holds one directory per finished leg, so the leg about to run is
# one past however many are archived (plus one more if a leg is sitting
# unarchived in the run directory, which is exactly the restart case).
narch=$(ls -d ${d}/legs/leg* 2>/dev/null | wc -l | tr -d ' ')

if [ -s "${d}/restart/ux.dat" ]; then
  leg=$((narch + 2))
  # Archive the finished leg's diagnostics before the code clobbers them.
  a="${d}/legs/leg$((narch + 1))"
  mkdir -p "${a}"
  for f in ${d}/gallope.out*.nc ${d}/gallope.modes.out ${d}/cfl.dat ${d}/rms.dat ${d}/out.std; do
    [ -e "${f}" ] && mv "${f}" "${a}/"
  done
  [ -d "${d}/out2d" ] && mv "${d}/out2d" "${a}/out2d" && mkdir -p "${d}/out2d"
  sed -e "s/^  init_type = .*/  init_type = 'restart'/" gallope.in > "${d}/gallope.in"
  echo "[prod-g] leg ${leg}: continuing from restart, previous leg archived in ${a}"
else
  leg=1
  cp gallope.in "${d}/gallope.in"
  echo "[prod-g] leg ${leg}: fresh start"
fi

( cd "${d}" && mpirun ./gallope <gallope.in >out.std 2>&1 )
rc=$?

echo "[prod-g] leg ${leg} rc=${rc}"
echo "[prod-g] reached t = $(cat ${d}/restart/time.dat 2>/dev/null | tr -d ' ' || echo MISSING)"
echo "[prod-g] last cfl.dat: $(tail -1 ${d}/cfl.dat 2>/dev/null || echo MISSING)"
grep -E "Advance steps|# of steps advanced|Final dt|wall time" "${d}/out.std" | head -6
echo "MRI_PROD_G_DONE"
