#!/bin/sh -l
#------ qsub option --------#
#PBS -q debug-g
#PBS -l select=4:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -W group_list=gr96
#PBS -j oe
#PBS -N gpb_mid_rst

#=====================================================================
#  MID-RESOLUTION KRMHD run (64^2 x 32, nm=32, np=4) -- RESTART.
#  Meyrand et al. 2019 eq(7) 4D KRMHD, driven turbulence. Counterpart
#  of Meyrand19_test_lowres at 2x perp/para resolution + 2x Hermite
#  moments. Resumes from the tt=1.8 checkpoint (runs_gpb/restart/) of
#  the mu=2e2 run, now with mu_hyper_perp raised 2e2 -> 1e3. Preserves
#  restart/, clears only the stale mu=2e2 diagnostics; outputs land in
#  runs_gpb/ fresh from tt=1.8.
#=====================================================================
module load nvidia
module load nv-hpcx
module load hdf5
module load netcdf
module load netcdf-fortran

set -u
cd ${PBS_O_WORKDIR}

ROOT=${PBS_O_WORKDIR}
BIN=${ROOT}/../../gallope        # tests/Meyrand19_test_midres -> repo root
INPUT=midres_gpb.in
RUN=${ROOT}/runs_gpb

# --- RESTART: keep runs_gpb/restart/ (the tt=1.8 checkpoint init_type= ---
# --- 'restart' reads); clear only the stale mu=2e2 diagnostics. The     ---
# --- code reopens nc (NF90_CLOBBER) and rms/cfl (status="replace")       ---
# --- fresh, but out2d MPI-IO (MPI_MODE_CREATE, no truncate) would keep   ---
# --- stale trailing time-slices, so wipe out2d/out3d explicitly.         ---
if [ ! -f "${RUN}/restart/time.dat" ]; then
  echo "ERROR: no restart checkpoint at ${RUN}/restart/ (time.dat missing); aborting."
  exit 1
fi
mkdir -p "${RUN}/out2d" "${RUN}/out3d"
find "${RUN}/out2d" -type f -delete
find "${RUN}/out3d" -type f -delete
rm -f "${RUN}/gallope.out.nc" "${RUN}/rms.dat" "${RUN}/cfl.dat" "${RUN}/out.std"
cp "${ROOT}/${INPUT}" "${RUN}/gallope.in"

echo "================ g power-balance midres RESTART mu=1e3 (64^2 x 32, nm=32, np=4) ================"
echo "----- restart checkpoint (runs_gpb/restart/) -----"
ls -la "${RUN}/restart"; cat "${RUN}/restart/time.dat"
t0=$(date +%s)
( cd "${RUN}" && mpirun -np 4 "${BIN}" <gallope.in >out.std 2>&1 )
rc=$?
t1=$(date +%s)
echo "[driver] done, rc=${rc}, wall=$((t1 - t0))s"

echo "----- tail of out.std -----"
tail -40 "${RUN}/out.std"
echo "----- tail of cfl.dat: tt dt_cfl max_vel_x max_vel_y -----"
tail -4 "${RUN}/cfl.dat" 2>/dev/null || echo "(no cfl.dat)"

NC=$(ls "${RUN}"/*.out.nc 2>/dev/null | head -1)
if [ -z "${NC}" ]; then
  echo "ERROR: no NetCDF output"
else
  echo "----- NetCDF output -----"
  ls -la "${NC}"
fi
echo "GPB_DONE"
