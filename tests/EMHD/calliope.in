!--------------------------------------------------!
!  Calliope EMHD input matching tests/EMHD/gallope.in (e_ot3_np1/np4)
!  for the deterministic Gallope <-> Calliope comparison (V8).
!  Needs Calliope develop with tests/EMHD/calliope_OT3.patch applied.
!  One namelist item per line.
!--------------------------------------------------!
&mpi_settings
  dim_decomp = 2
/
&box_parameters
  lx = 1.0
  ly = 1.0
  lz = 1.0
  nlx = 64
  nly = 64
  nlz = 32
  pruned = .false.
/
&time_parameters
  dt    = 1.0d-3
  nstep = 200
  cfl   = 1.0d0
  reset_method = 'multiply'
  increase_dt = 0e+0
/
&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/
&operation_parameters
  nonlinear = T
/
&physical_parameters
  eta     = 1.0d+2
  eta_exp = 2
  de      = 1.0d-1
/
&initial_condition
  init_type = 'OT3'
/
&initial_condition_params
  b0 = 0.d0  0.d0  1.d0
/
&force
  driven = F
/
&terminate
  max_wall_time   = 0.5
  terminate_file_name = 'terminate'
/
&diagnostics_parameters
  write_intvl       = 0.01d0
  write_intvl_2D    = 0.1d0
  write_intvl_3D    = 0.0d0
/
&restart_parameters
  save_restart_intvl = 10.0d0
  restart_dir = './restart/'
/
