!--------------------------------------------------------------------!
!  LOW-RESOLUTION g power-balance check (32^2 x 16, nm=16, np=1).      !
!                                                                     !
!  Purpose: verify the newly added compressive free-energy power       !
!  balance diagnostic  dW_free/dt = P_g - D_g  (Meyrand 2019 eq.6),     !
!  where P_g (p_g_sum) = g1-forcing injection and D_g (Dg_sum) = the    !
!  perp-hyperviscous + Hermite-hypercollisional dissipation, both       !
!  output by KRMHD/diagnostics.F90:get_g_power_balance.                 !
!                                                                     !
!  np=1 => [P_fft=1, P_m=1, P_s=1]: the single rank owns all m, so the  !
!  comm_fm reduction is trivial and the physics (not the split) is on   !
!  trial here -- P_m bit-invariance was already validated in 1-B. Both  !
!  Alfvenic (zppe,zmpe) and compressive (g1) drives share the low-k     !
!  stir shell. Frequent diagnostics (write_intvl=0.1) so the Python     !
!  finite-difference dW_free/dt closes tightly against P_g - D_g.       !
!  debug-g queue (1 node, <=30 min) is ample for this size.             !
!--------------------------------------------------------------------!
&parallelization
  P_m = 1
  P_s = 1
/

&box_parameters
  lx = 1.0
  ly = 1.0
  lz = 1.0
  nlx = 32
  nly = 32
  nlz = 16
  nm  = 16
/

&time_parameters
  dt    = 5.0d-3
  nstep = 20000
  cfl   = 0.5d0
  reset_method = 'decrement'
  increase_dt = 0e+0
/

&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

&operation_parameters
  nonlinear          = T
  write_hermite_flux = F
/

&physical_parameters
  ! Alfvenic (phi,psi) hyper-dissipation (RMHD-inherited); modest values,
  ! only needs to keep the Alfven bath bounded at this small grid.
  nupe_x      = 4.0d+3
  nupe_x_exp  = 4
  etape_x     = 4.0d+3
  etape_x_exp = 4
  nupe_z      = 4.0d+1
  nupe_z_exp  = 4
  etape_z     = 4.0d+1
  etape_z_exp = 4

  ! Kinetic (g) closure: perp k^4 hyperviscosity + Hermite m^6 hypercollision.
  ! These ARE the D_g sink checked by the balance, so both are nonzero.
  ! v_th is derived (= sqrt(beta_i) = 1 here).
  mu_hyper_perp = 1.0d+2
  nexp_perp     = 2
  nu_hyper_m    = 3.0d0
  nexp_m        = 6
  beta_i        = 1.d0
  tau           = 1.d0
  Zcharge       = 1.d0
  alpha_root    = 1
/

&initial_condition
  init_type = 'random'
  init_seed = 7
/

&force
  driven    = T
  elsasser  = .true.
  fix_power = .true.
  ene_inj   = 1.0d0
  xhl_inj   = 0.0d0
  ene_inj_g = 1.0d0
  kmin = 0.d0  0.d0  1.d0
  kmax = 1.0d0  1.0d0  2.d0
  nfields = 3
  stir_seed = 7
/
&forced_fields
  field_names = 'zppe'      , 'zmpe'      , 'g1'
  amplitudes  =  1.0        ,  1.0        ,  1.0
  frequencies = (0.9, -0.6) , (0.9, -0.6) , (0.9, -0.6)
/

&terminate
  max_wall_time   = 0.45
  terminate_file_name = 'terminate'
/

&diagnostics_parameters
  write_intvl         = 0.1d0
  write_intvl_2D      = 2.0d0   ! EM field real-space cross-sections for plot_fields
  write_intvl_3D      = 0.0d0
  SF2_nsample = 100000
/

&restart_parameters
  save_restart_intvl = 5.0d0
  restart_dir = './restart/'
/
