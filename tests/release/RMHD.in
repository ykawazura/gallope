!--------------------------------------------------!
!   Release check (v1.0 vs v1.1): RMHD base        !
!   One namelist item per line (nvfortran stops a  !
!   group at a semicolon). Cases: setup_runs.sh.   !
!--------------------------------------------------!
&parallelization
  P_m = 1
  P_s = 1
/

&box_parameters
  lx = 1.0
  ly = 1.0
  lz = 1.0
  nlx = 64
  nly = 64
  nlz = 32
/

&time_parameters
  dt    = 1.0d-3
  nstep = 200
  cfl   = 1.0d0
  reset_method = 'decrement'
  increase_dt = 0e+0
/

&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

&operation_parameters
  nonlinear = T
/

&physical_parameters
  nupe_x      = 4d+3
  nupe_x_exp  = 4
  etape_x     = 4d+3
  etape_x_exp = 4
  nupe_z      = 4d+1
  nupe_z_exp  = 4
  etape_z     = 4d+1
  etape_z_exp = 4
/

&initial_condition
  init_type = 'OT3'
  init_seed = 1
/

&force
  driven = F
  elsasser = .true.
  fix_power = .true.
  ene_inj = 1.0d0
  xhl_inj = 0.5d0
  kmin = 0.d0  0.d0  1.d0
  kmax = 1.d0  1.d0  2.d0
  nfields = 2
  stir_seed = 1
/
&forced_fields
  field_names = 'zppe'      , 'zmpe'
  amplitudes  =  1.0        ,  1.0
  frequencies = (0.9, -0.6) , (0.9, -0.6)
/

&terminate
  max_wall_time   = 0.5
  terminate_file_name = 'terminate'
/

&diagnostics_parameters
  write_intvl         = 0.01d0
  write_intvl_2D      = 0.0d0
  write_intvl_3D      = 0.0d0
  write_intvl_kpar    = 0.0d0
  write_intvl_SF2     = 0.0d0
  write_intvl_nltrans = 0.0d0
/

&restart_parameters
  save_restart_intvl = 10.0d0
  restart_dir = './restart/'
/
