#!/bin/sh -l
#PBS -q short-g
#PBS -l select=1:mpiprocs=16:ompthreads=1
#PBS -l walltime=01:00:00
#PBS -W group_list=gr96
#PBS -j oe
#PBS -N det-linorder
#=====================================================================
#  Third probe.  So far:
#    shear off -> both codes converge at third order (ratio 8.00)
#    shear on  -> both codes converge at first order (ratio 2.00)
#    shear on, nonlinear off -> B agrees to 1e-16, u does not, and the
#      whole difference sits on the single mode k = (+-1, 0, +-1),
#      which has ky = 0 and therefore a time-INDEPENDENT kxt
#
#  That last point rules out the obvious explanation (kxt held fixed
#  across the three RK stages), so this probe measures the order of the
#  linear problem alone: shear on, nonlinear off, dt refined twice.
#  Third order here would put the order loss in the nonlinear term
#  evaluated on the sheared grid; first order puts it in the linear
#  Coriolis / shear / pressure-projection block.
#=====================================================================
module load nvidia
module load nv-hpcx
module load hdf5
module load netcdf
module load netcdf-fortran

set -u
cd ${PBS_O_WORKDIR}

NP=16

probe() {
  tag=$1; nstep=$2; dt=$3
  for code in gallope calliope; do
    d="lin_${tag}_${code}"
    rm -rf "${d}"
    mkdir -p "${d}/restart" "${d}/out2d" "${d}/out3d"
    sed -e "s/^  nstep = .*/  nstep = ${nstep}/" \
        -e "s/^  dt    = .*/  dt    = ${dt}/" \
        -e "s/^  nonlinear = .*/  nonlinear = F/" \
        -e "s/^  shear  = .*/  shear  = .true./" \
        -e "s/^  q      = .*/  q      = 1.5d0/" \
        ${code}.in > "${d}/${code}.in"
    ln -sf ../${code} "${d}/${code}"
    if [ ${code} = gallope ]; then
      ( cd "${d}" && mpirun -n 1 ./gallope <gallope.in >out.std 2>&1 )
    else
      ( cd "${d}" && mpirun -n ${NP} ./calliope <calliope.in >out.std 2>&1 )
    fi
    echo "[lin] ${d} rc=$? time.dat: $(tail -1 ${d}/restart/time.dat 2>/dev/null || echo MISSING)"
  done
}

probe dt1e3  100 "1.0d-3"
probe dt5e4  200 "5.0d-4"
probe dt25e5 400 "2.5d-4"

echo "DET_LINORDER_DONE"
