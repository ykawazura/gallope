#!/bin/sh -l
#PBS -q short-g
#PBS -l select=1:mpiprocs=16:ompthreads=1
#PBS -l walltime=02:00:00
#PBS -W group_list=gr96
#PBS -j oe
#PBS -N det-orderprobe
#=====================================================================
#  Control for job.pbs-shearprobe.  That probe found that with shear
#  on, BOTH codes self-converge at first order in dt, not third.  This
#  one repeats the same dt refinement with shear OFF.  If the no-shear
#  series converges at third order, the loss of accuracy is caused by
#  the shearing-box treatment specifically and not by the eSSPIFRK3
#  integrator or by the test harness.
#
#  Same final time t = 0.1 in every run, so the three restarts are
#  directly differenceable.
#=====================================================================
module load nvidia
module load nv-hpcx
module load hdf5
module load netcdf
module load netcdf-fortran

set -u
cd ${PBS_O_WORKDIR}

NP=16

# $1 tag  $2 nstep  $3 dt
probe() {
  tag=$1; nstep=$2; dt=$3
  for code in gallope calliope; do
    d="order_${tag}_${code}"
    rm -rf "${d}"
    mkdir -p "${d}/restart" "${d}/out2d" "${d}/out3d"
    sed -e "s/^  nstep = .*/  nstep = ${nstep}/" \
        -e "s/^  dt    = .*/  dt    = ${dt}/" \
        -e "s/^  shear  = .*/  shear  = .false./" \
        -e "s/^  q      = .*/  q      = 0.d0/" \
        ${code}.in > "${d}/${code}.in"
    ln -sf ../${code} "${d}/${code}"
    if [ ${code} = gallope ]; then
      ( cd "${d}" && mpirun -n 1 ./gallope <gallope.in >out.std 2>&1 )
    else
      ( cd "${d}" && mpirun -n ${NP} ./calliope <calliope.in >out.std 2>&1 )
    fi
    echo "[order] ${d} rc=$? time.dat: $(tail -1 ${d}/restart/time.dat 2>/dev/null || echo MISSING)"
  done
}

probe dt1e3  100 "1.0d-3"
probe dt5e4  200 "5.0d-4"
probe dt25e5 400 "2.5d-4"

echo "DET_ORDERPROBE_DONE"
