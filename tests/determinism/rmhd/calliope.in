!--------------------------------------------------!
!   Deterministic Gallope <-> Calliope comparison   !
!   RMHD, 3D Orszag-Tang (analytic IC)              !
!--------------------------------------------------!
!  Paired with gallope.in in this directory. Every physical and numerical
!  parameter is identical to that file. The intentional differences are the
!  &mpi_settings group, which has no Gallope counterpart, the empty
!  &forced_fields, and `pruned = .false.`, which is REQUIRED: with the
!  default `pruned = .true.` Calliope transforms on a reduced spectral grid
!  of size int(2*nl/3)+2, so its arrays would not be mode-for-mode
!  comparable with Gallope's full nlx x nly x (nlz/2+1). See README.md.
!--------------------------------------------------!
&mpi_settings
  dim_decomp = 2
/

!==============================================================================
&box_parameters
  lx = 1.0 ! to be multiplied by 2pi
  ly = 1.0 ! to be multiplied by 2pi
  lz = 1.0 ! to be multiplied by 2pi

  nlx = 128
  nly = 128
  nlz = 128

  pruned = .false.
/

!==============================================================================
&time_parameters
  dt    = 1.0d-3
  nstep = 1000
  cfl   = 2.0d0
  reset_method = 'multiply'
  increase_dt = 0e+0
/

!==============================================================================
&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

!==============================================================================
&operation_parameters
  nonlinear = T
/

!==============================================================================
&physical_parameters
  ! damping rate = nupe_x*(kprp^2/kprp2_max)^nupe_x_exp
  !              + nupe_z*(kz^2  /kz2_max  )^nupe_z_exp
  nupe_x      = 1d+2  ! perp viscosity   for phi
  nupe_x_exp  = 4
  etape_x     = 1d+2  ! perp resistivity for psi
  etape_x_exp = 4

  nupe_z      = 1d+1  ! para viscosity   for phi
  nupe_z_exp  = 4
  etape_z     = 1d+1  ! para resistivity for psi
  etape_z_exp = 4
/

!==============================================================================
&initial_condition
  init_type = 'OT3'
/

!==============================================================================
&force
  driven = F
  nfields = 0
/
&forced_fields
/

!==============================================================================
&terminate
  max_wall_time   = 24.
  terminate_file_name = 'terminate'
/

!==============================================================================
&diagnostics_parameters
  write_intvl         = 1.0d-2  ! every 10 steps
  write_intvl_2D      = 0.0d0
  write_intvl_3D      = 0.0d0
  write_intvl_kpar    = 0.0d0
  write_intvl_SF2     = 0.0d0
  SF2_nsample = 100000
/

!==============================================================================
&restart_parameters
  save_restart_intvl = 0.0d0
  restart_dir = './restart/'
/
