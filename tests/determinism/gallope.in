!--------------------------------------------------!
!   Deterministic Gallope <-> Calliope comparison   !
!   MHD_INCOMP, 3D Orszag-Tang (analytic IC)        !
!--------------------------------------------------!
!  Paired with calliope.in in this directory. Every physical and numerical
!  parameter below must be kept identical in the two files; the only
!  intentional difference is Calliope's &mpi_settings and its
!  `pruned = .false.` (which makes its spectral grid the same full
!  nlx x nly x nlz as Gallope's -- see README.md).
!--------------------------------------------------!
&box_parameters
  lx = 1.0 ! to be multiplied by 2pi
  ly = 1.0 ! to be multiplied by 2pi
  lz = 1.0 ! to be multiplied by 2pi

  nlx = 128
  nly = 128
  nlz = 128
/

!==============================================================================
&time_parameters
  dt    = 1.0d-3
  nstep = 1000
  cfl   = 2.0d0             ! dt_cfl ~ 2*(2pi/128)/|u|_max ~ 5d-2 >> dt, so the
                            ! adaptive reset never fires and dt stays fixed at
                            ! 1.0d-3. This is required for the comparison to be
                            ! step-by-step meaningful; verified from cfl.dat.
  reset_method = 'multiply'
  increase_dt = 0e+0
/

!==============================================================================
&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

!==============================================================================
&operation_parameters
  nonlinear = T
/

!==============================================================================
&physical_parameters
  ! damping rate = nu*(k^2/k2_max) + nu_h*(k^2/k2_max)^nu_h_exp
  nu        = 0d+0
  nu_h      = 1d+2
  nu_h_exp  = 4
  eta       = 0d+0
  eta_h     = 1d+2
  eta_h_exp = 4

  shear  = .false.
  q      = 0.d0
/

!==============================================================================
&initial_condition
  init_type = 'OT3'   ! ux = -sin(y+z), uy = sin(x+z), bx = -sin(y+z), by = sin(2x+z)
                      ! uz = bz = 0. Exactly solenoidal and fully three
                      ! dimensional, so the kz != 0 dynamics is exercised.
/

&initial_condition_params
  kmin = 0.d0   0.d0   0.d0
  kmax = 3.d0   3.d0   3.d0
  b0   = 0.d0   0.d0   0.d0
  b1   = 0.d0   0.d0   0.d0
  u1   = 0.d0   0.d0   0.d0
  nf_or_znf = 'nf'
/

!==============================================================================
&force
  driven = F
  nfields = 0
/

!==============================================================================
&terminate
  max_wall_time   = 24.
  terminate_file_name = 'terminate'
/

!==============================================================================
&diagnostics_parameters
  write_intvl         = 1.0d-2  ! every 10 steps
  write_intvl_2D      = 0.0d0
  write_intvl_3D      = 0.0d0
  write_intvl_kpar    = 0.0d0
  write_intvl_SF2     = 0.0d0
  write_intvl_nltrans = 0.0d0
  SF2_nsample = 100000

  output_modes =   3   1   2
                   5   1   3
                   7   1   4
/

!==============================================================================
&restart_parameters
  save_restart_intvl = 0.0d0      ! 0 => no periodic save; the unconditional
                                  ! save_restart at the end of the main loop
                                  ! still writes restart/ at exactly nstep.
  restart_dir = './restart/'
/
