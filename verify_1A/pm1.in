!--------------------------------------------------!
!  1-A test (ii) baseline: nm=4, P_m=1, P_s=1.      !
!  Run with nproc=4 => P_fft=4. Random init         !
!  (init_seed=42): phi/psi identical to pm4, g       !
!  seeded by GLOBAL m so g is P_m-invariant. driven=F !
!  gives deterministic passive advection. Final g    !
!  XOR checksum (and restart/g.dat) must match the   !
!  pm4 run (nproc=16, P_m=4, SAME P_fft=4) bitwise.  !
!  Also the source for the round-trip test (iii).    !
!--------------------------------------------------!
&parallelization
  P_m = 1
  P_s = 1
/

&box_parameters
  lx = 1.0
  ly = 1.0
  lz = 1.0
  nlx = 64
  nly = 64
  nlz = 64
  nm  = 4
/

&time_parameters
  dt    = 5.0d-3
  nstep = 20
  cfl   = 2.0d0
  reset_method = 'decrement'
  increase_dt = 0e+0
/

&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

&operation_parameters
  nonlinear = T
/

&physical_parameters
  nupe_x      = 4d+3
  nupe_x_exp  = 4
  etape_x     = 4d+3
  etape_x_exp = 4
  nupe_z      = 4d+1
  nupe_z_exp  = 4
  etape_z     = 4d+1
  etape_z_exp = 4

  v_th          = 1.d0
  mu_hyper_perp = 0.d0
  nexp_perp     = 4
  nu_hyper_m    = 0.d0
  nexp_m        = 6
  beta_i        = 1.d0
  tau           = 1.d0
  Zcharge       = 1.d0
  alpha_root    = 1
/

&initial_condition
  init_type = 'random'
  init_seed = 42
/

&force
  driven = F
/

&terminate
  max_wall_time   = 0.5
  terminate_file_name = 'terminate'
/

&diagnostics_parameters
  write_intvl         = 0.05d0
  write_intvl_2D      = 0.0d0
  write_intvl_3D      = 0.0d0
  SF2_nsample = 100000
/

&restart_parameters
  save_restart_intvl = 100.0d0
  restart_dir = './restart/'
/
