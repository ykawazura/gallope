!--------------------------------------------------!
!   Phase 0-B random-IC consistency input (RMHD)   !
!  nproc=4, P_m=2 => P_fft=2, P_s=1.                !
!  init_type='random' with a FIXED init_seed makes  !
!  the initial condition reproducible AND shared     !
!  across the redundant comm_m groups, so the run    !
!  is deterministic run-to-run and every group must  !
!  hold a bitwise-identical field                    !
!  (check_redundant_consistency must PASS).          !
!--------------------------------------------------!
&parallelization
  P_m = 2
/

&box_parameters
  lx = 1.0 ! to be multiplied by 2pi
  ly = 1.0 ! to be multiplied by 2pi
  lz = 1.0 ! to be multiplied by 2pi

  nlx = 128
  nly = 128
  nlz = 128
/

!==============================================================================
&time_parameters
  dt    = 5.0d-3
  nstep = 300
  cfl   = 2.0d0
  reset_method = 'decrement'
  increase_dt = 0e+0
/

!==============================================================================
&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/

!==============================================================================
&operation_parameters
  nonlinear = T
/

!==============================================================================
&physical_parameters
  ! regular and hyper viscosity ~ nu*k^2 + nu_h*k^(2*nu_h_exp)
  nupe_x      = 4d+3
  nupe_x_exp  = 4
  etape_x     = 4d+3
  etape_x_exp = 4

  nupe_z      = 4d+1
  nupe_z_exp  = 4
  etape_z     = 4d+1
  etape_z_exp = 4
/

!==============================================================================
&initial_condition
  init_type = 'random'
  init_seed = 42          ! fixed >= 0 => reproducible IC shared across comm_m groups
/

!==============================================================================
&force
  driven = T
  elsasser = .true.
  fix_power = .true.
  ene_inj = 1.0d0
  xhl_inj = 0.8d0
  kmin = 0.d0  0.d0  1.d0
  kmax = 1.0d0  1.0d0  2.d0
  nfields = 2
  stir_seed = 12345   ! fixed seed => reproducible forcing
/
&forced_fields
  field_names = 'zppe'      , 'zmpe'
  amplitudes  =  1.0      ,  1.0
  frequencies = (0.9, -0.6), (0.9, -0.6)
/

!==============================================================================
&terminate
  max_wall_time   = 0.3
  terminate_file_name = 'terminate'
/

!==============================================================================
&diagnostics_parameters
  write_intvl         = 0.05d0
  write_intvl_2D      = 0.0d0
  write_intvl_3D      = 0.0d0
  SF2_nsample = 100000
/

!==============================================================================
&restart_parameters
  save_restart_intvl = 0.5d0
  restart_dir = './restart_rand/'
/
